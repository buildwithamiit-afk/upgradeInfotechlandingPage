---
// Client-side Free Consultation Modal (Frictionless, High-Converting UI)
---

<div
  id="placement-report-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 sm:p-6 hidden opacity-0 transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="placement-modal-title"
>
  <!-- Main Modal Container (Frictionless 1-Column Design) -->
  <div class="bg-white rounded-2xl shadow-2xl max-w-[500px] w-full overflow-hidden relative transform scale-95 transition-all duration-300 border border-slate-100">
    
    <!-- Top Accent Bar -->
    <div class="h-2 w-full bg-primary"></div>

    <!-- Close Button -->
    <button
      id="placement-modal-close"
      class="absolute top-5 right-5 z-20 text-slate-400 hover:text-slate-800 bg-slate-50 hover:bg-slate-100 p-2 rounded-full transition-all focus:outline-none group"
      aria-label="Close popup"
    >
      <svg class="w-5 h-5 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="p-8 sm:p-10">
      
      <!-- Header -->
      <div class="text-center mb-6">
        <div class="flex items-center justify-center mb-4">
          <img src="/main_logo.png" alt="Upgrade Infotech Logo" class="h-9 sm:h-11 w-auto object-contain" />
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-black uppercase tracking-wider mb-2.5">
          <span>⚡</span> Free Career Roadmap
        </div>
        <h2 id="placement-modal-title" class="text-2xl sm:text-[1.75rem] font-black text-slate-900 tracking-tight leading-tight mb-2">
          See If You Qualify
        </h2>
        <p class="text-xs sm:text-sm font-medium text-slate-500 max-w-sm mx-auto">
          Get fees, batch dates & eligibility structure in 30 mins.
        </p>
      </div>

      <!-- Frictionless Form -->
      <form id="placement-report-form" class="space-y-3.5">
        <!-- Invisible Honeypot Field for Anti-Bot Protection -->
        <input
          type="text"
          name="website_url"
          id="placement-modal-website-url"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] opacity-0 pointer-events-none h-0 w-0"
        />
        
        <!-- Name -->
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-primary transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </div>
          <input
            type="text"
            id="placement-modal-name"
            name="name"
            required
            placeholder="Your Full Name"
            class="w-full h-12 pl-11 pr-4 rounded-xl border border-slate-200 bg-slate-50/50 text-sm font-bold focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary focus:outline-none transition-all text-slate-800 placeholder:text-slate-400 shadow-sm"
          />
        </div>

        <!-- Phone with +91 indicator -->
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-primary transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          </div>
          <div class="absolute left-11 inset-y-0 flex items-center justify-center pointer-events-none">
            <span class="text-sm font-bold text-slate-400 border-r border-slate-200 pr-2">+91</span>
          </div>
          <input
            type="tel"
            id="placement-modal-phone"
            name="phone"
            required
            pattern="[0-9]{10}"
            maxlength="10"
            placeholder="10-digit mobile number"
            class="w-full h-12 pl-[5.5rem] pr-4 rounded-xl border border-slate-200 bg-slate-50/50 text-sm font-bold focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary focus:outline-none transition-all text-slate-800 placeholder:text-slate-400 shadow-sm"
          />
        </div>

        <!-- Course Interested In -->
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-primary transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          </div>
          <select
            id="placement-modal-course"
            name="course"
            required
            class="w-full h-12 pl-11 pr-10 rounded-xl border border-slate-200 bg-slate-50/50 text-sm font-bold focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary focus:outline-none transition-all text-slate-800 appearance-none cursor-pointer shadow-sm invalid:text-slate-400"
            style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20fill%3D%22none%22%20stroke%3D%22%2364748b%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 1rem center; background-size: 1.2em;"
          >
            <option value="" disabled selected>Course Interested In *</option>
            <option value="SAP FICO" class="text-slate-800">SAP FICO (Finance)</option>
            <option value="SAP MM" class="text-slate-800">SAP MM (Materials)</option>
            <option value="SAP SD" class="text-slate-800">SAP SD (Sales)</option>
            <option value="SAP HR" class="text-slate-800">SAP HR / HCM</option>
            <option value="SAP ABAP" class="text-slate-800">SAP ABAP</option>
            <option value="Other" class="text-slate-800">Other</option>
          </select>
        </div>

        <!-- Preferred Location -->
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-primary transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <select
            id="placement-modal-location"
            name="location"
            required
            class="w-full h-12 pl-11 pr-10 rounded-xl border border-slate-200 bg-slate-50/50 text-sm font-bold focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary focus:outline-none transition-all text-slate-800 appearance-none cursor-pointer shadow-sm invalid:text-slate-400"
            style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20fill%3D%22none%22%20stroke%3D%22%2364748b%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 1rem center; background-size: 1.2em;"
          >
            <option value="" disabled selected>Preferred Location *</option>
            <option value="Andheri Classroom" class="text-slate-800">Andheri Classroom</option>
            <option value="Ghatkopar Classroom" class="text-slate-800">Ghatkopar Classroom</option>
            <option value="Vashi Classroom" class="text-slate-800">Vashi Classroom</option>
            <option value="Live Online Batch" class="text-slate-800">Live Online Batch</option>
          </select>
        </div>

        <!-- Privacy Microcopy DIRECTLY ABOVE CTA BUTTON -->
        <div class="flex items-center justify-center gap-1.5 text-[11px] text-primary font-bold bg-primary-light py-2 px-3 rounded-lg border border-primary/20">
          <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <span>100% Confidential · No Spam · Response in 30 mins</span>
        </div>

        <!-- Premium Submit Button -->
        <button
          type="submit"
          id="placement-modal-submit-btn"
          class="w-full h-12 mt-1 flex justify-center items-center rounded-xl font-bold text-white text-[15px] tracking-wide bg-primary hover:bg-primary-hover transition-all shadow-sm focus:outline-none group hover:-translate-y-0.5 cursor-pointer"
        >
          <span class="relative flex items-center gap-2">
            Get Fee & Free Demo Class
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </span>
        </button>
      </form>

    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('placement-report-modal');
    const closeBtn = document.getElementById('placement-modal-close');
    const placementForm = document.getElementById('placement-report-form');
    
    const inputName = document.getElementById('placement-modal-name');
    const inputPhone = document.getElementById('placement-modal-phone');
    const inputCourse = document.getElementById('placement-modal-course');
    const inputLocation = document.getElementById('placement-modal-location');
    const honeypotInput = document.getElementById('placement-modal-website-url');
    const submitBtn = document.getElementById('placement-modal-submit-btn');

    let modalOpenTime = Date.now();
    const MIN_SUBMISSION_TIME_MS = 3000;
    const RATE_LIMIT_WINDOW_MS = 30000;
    let isSubmitting = false;
    const originalBtnContent = submitBtn ? submitBtn.innerHTML : 'Submit & Check Eligibility';
    
    // Attach event listeners to all triggers across the site
    const triggerButtons = document.querySelectorAll('.placement-popup-trigger');
    triggerButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        modalOpenTime = Date.now();
        if (modal) {
          modal.classList.remove('hidden');
          // Small delay to allow display:block to apply before animating opacity/transform
          setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.firstElementChild.classList.remove('scale-95');
            modal.firstElementChild.classList.add('scale-100');
          }, 10);
        }
      });
    });

    const closeModal = () => {
      if (modal) {
        modal.classList.add('opacity-0');
        modal.firstElementChild.classList.remove('scale-100');
        modal.firstElementChild.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
        }, 300);
      }
    };

    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    if (placementForm && submitBtn) {
      placementForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Submission Lock: Prevent duplicate submissions
        if (isSubmitting) return;

        // 2. Honeypot check: If filled, silently drop and simulate completion
        if (honeypotInput && honeypotInput.value.trim() !== '') {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting Details...';
          setTimeout(() => {
            window.location.href = '/thank-you';
          }, 800);
          return;
        }

        // 3. Minimum interaction time check: Humans take > 3 seconds to complete the form
        const elapsedTime = Date.now() - modalOpenTime;
        if (elapsedTime < MIN_SUBMISSION_TIME_MS) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting Details...';
          setTimeout(() => {
            window.location.href = '/thank-you';
          }, 1000);
          return;
        }

        // 4. Client-side Rate Limiting (30s window per browser)
        try {
          const lastSubmission = localStorage.getItem('lead_form_last_submission');
          if (lastSubmission && (Date.now() - parseInt(lastSubmission, 10)) < RATE_LIMIT_WINDOW_MS) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting Details...';
            setTimeout(() => {
              window.location.href = '/thank-you';
            }, 600);
            return;
          }
        } catch (storageErr) {}

        // 5. Validation
        const nameVal = inputName ? inputName.value.trim().slice(0, 100) : '';
        const rawPhone = inputPhone ? inputPhone.value.trim() : '';
        const phoneDigits = rawPhone.replace(/\D/g, '');
        const courseVal = inputCourse ? inputCourse.value : 'SAP FICO';
        const locationVal = inputLocation ? inputLocation.value : 'Andheri Classroom';

        if (nameVal.length < 2 || phoneDigits.length < 10) {
          alert('Please enter your full name (at least 2 characters) and a valid 10-digit mobile number.');
          return;
        }

        isSubmitting = true;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <span class="relative flex items-center gap-2">
            <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            Submitting Details...
          </span>
        `;

        try {
          await fetch('https://dashboard.conceptninjas.com/services/web/syncLead/NUo5VXowRTYwZU1xdHVmdUw1WlQvdz09', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: nameVal,
              email: 'info@upgradeinfotech.com',
              mobile: phoneDigits.slice(-10),
              course: courseVal,
              location: locationVal,
              message: `Free Career Roadmap / Qualify Lead (${courseVal} - ${locationVal})`,
              source: 'Free Career Roadmap Popup'
            })
          });

          try {
            localStorage.setItem('lead_form_last_submission', Date.now().toString());
          } catch (storageErr) {}

          // Redirect to Thank You page
          window.location.href = '/thank-you';
        } catch (err) {
          console.error('Submission failed:', err);
          isSubmitting = false;
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnContent;
          alert('Something went wrong while submitting. Please try again or call us directly.');
        }
      });
    }
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
