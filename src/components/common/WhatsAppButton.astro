---
// Floating Persistent Action Buttons (Desktop Only - Stacked on the Right Side)
---

<div class="hidden lg:flex fixed bottom-6 right-6 z-50 flex-col items-center gap-3.5" aria-label="Quick Contact Options">
  
  <!-- 1. Floating Call Button -->
  <a
    href="tel:+917021348186"
    class="flex items-center justify-center w-13 h-13 bg-primary hover:bg-primary-hover active:bg-primary text-white rounded-full shadow-xl shadow-primary/30 transition-all transform hover:scale-110 group focus:outline-none focus:ring-4 focus:ring-primary/30 relative"
    aria-label="Call Upgrade Infotech"
    title="Call Us: +91 70213 48186"
  >
    <svg class="w-6 h-6 fill-none stroke-current" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
    </svg>
    <!-- Tooltip on Hover -->
    <span class="absolute right-full mr-3 px-3 py-1.5 bg-slate-900 text-white text-xs font-bold rounded-lg shadow-lg whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200">
      Call +91 70213 48186
    </span>
  </a>

  <!-- 2. Floating WhatsApp Button -->
  <a
    href="https://wa.me/917021348186?text=Hi%20Upgrade%20Infotech,%20I%20want%20to%20know%20more%20about%20the%20SAP%20courses"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center w-14 h-14 bg-[#25D366] hover:bg-[#20ba59] active:bg-[#25D366] text-white rounded-full shadow-2xl shadow-[#25D366]/40 transition-all transform hover:scale-110 group focus:outline-none focus:ring-4 focus:ring-[#25D366]/30 relative"
    aria-label="Chat with SAP Counselor on WhatsApp"
    title="Chat on WhatsApp"
  >
    <span class="absolute top-1 right-1 flex h-3 w-3">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-white border-2 border-[#25D366]"></span>
    </span>

    <svg class="w-7 h-7 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
    <!-- Tooltip on Hover -->
    <span class="absolute right-full mr-3 px-3 py-1.5 bg-slate-900 text-white text-xs font-bold rounded-lg shadow-lg whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200">
      Chat on WhatsApp
    </span>
  </a>

</div>
