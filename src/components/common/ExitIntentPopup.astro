---
// Client-side Exit Intent Brochure Capture Modal
---

<div
  id="exit-intent-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/70 backdrop-blur-sm p-4 hidden opacity-0 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-modal-title"
>
  <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full overflow-hidden border border-border relative transform scale-95 transition-transform duration-300">
    
    <!-- Top Accent Bar -->
    <div class="h-2 bg-gradient-to-r from-primary via-accent to-secondary"></div>

    <!-- Close Button -->
    <button
      id="exit-modal-close"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1.5 rounded-full hover:bg-slate-100 transition-colors focus:outline-none"
      aria-label="Close popup"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="p-6 sm:p-7 text-center">
      
      <!-- Logo Badge -->
      <div class="flex justify-center mb-5">
        <img src="/main_logo.png" alt="Upgrade Infotech Logo" class="h-10 sm:h-12 w-auto object-contain" />
      </div>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent-light text-accent text-xs font-black uppercase tracking-wider mb-2">
        Before You Leave!
      </span>

      <h3 id="exit-modal-title" class="text-xl sm:text-2xl font-black text-heading tracking-tight mb-2">
        Download Free SAP Course Guide & Syllabus PDF
      </h3>
      <p class="text-xs text-body mb-5 font-medium leading-relaxed">
        Get the complete 2026 SAP FICO/MM/SD curriculum, placement stats, and detailed fee structure directly on your phone.
      </p>

      <form id="exit-intent-form" action="/api/lead" method="POST" class="space-y-3">
        <!-- Invisible Honeypot Field for Anti-Bot Protection -->
        <input
          type="text"
          name="website_url"
          id="exit-modal-website-url"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] opacity-0 pointer-events-none h-0 w-0"
        />
        <input
          type="text"
          id="exit-modal-name"
          name="name"
          required
          placeholder="Your Full Name"
          class="w-full h-11 px-3.5 rounded-xl border border-slate-300 text-sm font-semibold focus:ring-2 focus:ring-primary focus:outline-none bg-slate-50 text-heading"
        />
        <input
          type="tel"
          id="exit-modal-phone"
          name="phone"
          required
          pattern="[0-9]{10}"
          maxlength="10"
          placeholder="Your 10-Digit Mobile Number"
          class="w-full h-11 px-3.5 rounded-xl border border-slate-300 text-sm font-semibold focus:ring-2 focus:ring-primary focus:outline-none bg-slate-50 text-heading"
        />

        <button
          type="submit"
          id="exit-modal-submit-btn"
          class="w-full min-h-[46px] px-4 py-3 text-sm font-black text-white bg-accent hover:bg-accent-hover rounded-xl shadow-md transition-all cursor-pointer"
        >
          Download Free Syllabus PDF →
        </button>
      </form>

      <p class="text-[10px] text-slate-400 mt-3 font-medium">
        🔒 Instant WhatsApp download · No spam calls
      </p>

    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('exit-intent-modal');
    const closeBtn = document.getElementById('exit-modal-close');
    const exitForm = document.getElementById('exit-intent-form');
    const exitName = document.getElementById('exit-modal-name');
    const exitPhone = document.getElementById('exit-modal-phone');
    const honeypotInput = document.getElementById('exit-modal-website-url');
    const exitSubmitBtn = document.getElementById('exit-modal-submit-btn');
    let hasTriggered = false;

    let modalOpenTime = Date.now();
    const MIN_SUBMISSION_TIME_MS = 3000;
    const RATE_LIMIT_WINDOW_MS = 30000;
    let isSubmitting = false;
    const originalBtnText = exitSubmitBtn ? exitSubmitBtn.textContent : 'Download Free Syllabus PDF →';

    // Trigger on desktop mouseleave (leaving viewport top)
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 10 && !hasTriggered && modal) {
        hasTriggered = true;
        modalOpenTime = Date.now();
        modal.classList.remove('hidden');
        setTimeout(() => {
          modal.classList.remove('opacity-0');
        }, 10);
      }
    });

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => {
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
        }, 300);
      });

      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('opacity-0');
          setTimeout(() => {
            modal.classList.add('hidden');
          }, 300);
        }
      });
    }

    if (exitForm && exitSubmitBtn) {
      exitForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Submission Lock: Prevent duplicate submissions
        if (isSubmitting) return;

        // 2. Honeypot check: If filled, silently drop and simulate completion
        if (honeypotInput && honeypotInput.value.trim() !== '') {
          exitSubmitBtn.disabled = true;
          exitSubmitBtn.textContent = 'Sending...';
          setTimeout(() => {
            window.location.href = '/thank-you';
          }, 800);
          return;
        }

        // 3. Minimum interaction time check: Humans take > 3 seconds to complete the form
        const elapsedTime = Date.now() - modalOpenTime;
        if (elapsedTime < MIN_SUBMISSION_TIME_MS) {
          exitSubmitBtn.disabled = true;
          exitSubmitBtn.textContent = 'Sending...';
          setTimeout(() => {
            window.location.href = '/thank-you';
          }, 1000);
          return;
        }

        // 4. Client-side Rate Limiting (30s window per browser)
        try {
          const lastSubmission = localStorage.getItem('lead_form_last_submission');
          if (lastSubmission && (Date.now() - parseInt(lastSubmission, 10)) < RATE_LIMIT_WINDOW_MS) {
            exitSubmitBtn.disabled = true;
            exitSubmitBtn.textContent = 'Sending...';
            setTimeout(() => {
              window.location.href = '/thank-you';
            }, 600);
            return;
          }
        } catch (storageErr) {}

        // 5. Validation
        const nameVal = exitName ? exitName.value.trim().slice(0, 100) : '';
        const rawPhone = exitPhone ? exitPhone.value.trim() : '';
        const phoneDigits = rawPhone.replace(/\D/g, '');

        if (nameVal.length < 2 || phoneDigits.length < 10) {
          alert('Please enter your full name (at least 2 characters) and a valid 10-digit mobile number.');
          return;
        }

        isSubmitting = true;
        exitSubmitBtn.disabled = true;
        exitSubmitBtn.textContent = 'Sending...';

        try {
          await fetch('https://dashboard.conceptninjas.com/services/web/syncLead/NUo5VXowRTYwZU1xdHVmdUw1WlQvdz09', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: nameVal,
              email: 'info@upgradeinfotech.com',
              mobile: phoneDigits.slice(-10),
              course: 'SAP Course Syllabus PDF',
              location: 'Andheri',
              message: 'Exit Intent Brochure Download Lead',
              source: 'Exit Intent Popup'
            })
          });

          try {
            localStorage.setItem('lead_form_last_submission', Date.now().toString());
          } catch (storageErr) {}

          // Redirect to Thank You page
          window.location.href = '/thank-you';
        } catch (err) {
          console.error('Submission failed:', err);
          isSubmitting = false;
          exitSubmitBtn.disabled = false;
          exitSubmitBtn.textContent = originalBtnText;
          alert('Something went wrong while submitting. Please try again or call us directly.');
        }
      });
    }
  });
</script>
