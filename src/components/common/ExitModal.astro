---
// Exit Intent Popup Component with Attractive Monsoon Discount Offer & Direct CTAs
---

<div
  id="exit-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-slate-950/80 backdrop-blur-md transition-opacity duration-300 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-modal-title"
>
  <div
    class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-lg w-full overflow-hidden relative transform scale-95 transition-transform duration-300"
    id="exit-modal-card"
  >
    <!-- Top Gradient Accent Bar -->
    <div class="h-2 bg-gradient-to-r from-accent via-amber-500 to-primary"></div>

    <!-- Close Button -->
    <button
      id="close-exit-modal"
      class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-800 flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-primary cursor-pointer z-10"
      aria-label="Close offer modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Content -->
    <div class="p-6 sm:p-8 text-center space-y-4">
      
      <!-- Urgency Pill Tag -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-xs font-black text-amber-700 uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
        <span>🎁 SPECIAL MONSOON SCHOLARSHIP</span>
      </div>

      <!-- Main Headline -->
      <h2 id="exit-modal-title" class="text-2xl sm:text-3xl font-black text-heading font-serif tracking-tight leading-tight">
        Wait! Don't Miss Out On <span class="text-accent underline decoration-amber-400 decoration-wavy">₹10,000 OFF</span>
      </h2>

      <!-- Subtitle -->
      <p class="text-xs sm:text-sm text-body font-medium leading-relaxed max-w-sm mx-auto">
        Claim an instant ₹10,000 fee waiver & get a 1-on-1 SAP career counseling roadmap call with certified SAP consultants.
      </p>

      <!-- Key Benefits List -->
      <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200/80 space-y-2 text-left text-xs font-bold text-heading">
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs shrink-0">✓</span>
          <span>100% Placement Assistance with 500+ Hiring MNCs</span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs shrink-0">✓</span>
          <span>Certified SAP Trainers & Live S/4HANA Project Servers</span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs shrink-0">✓</span>
          <span>0% Interest No-Cost EMI Options Available</span>
        </div>
      </div>

      <!-- Action Buttons Row -->
      <div class="space-y-3 pt-2">
        <!-- WhatsApp 1-Click Offer Claim Button -->
        <a
          href="https://wa.me/917021348186?text=Hi%20Upgrade%20Infotech,%20I%20want%20to%20claim%20the%20Rs%2010,000%20Monsoon%20Offer%20Discount%20voucher"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center min-h-[48px] px-6 py-3 text-sm font-extrabold text-white bg-gradient-to-r from-[#25D366] to-[#128C7E] hover:opacity-95 active:scale-[0.99] rounded-xl shadow-lg shadow-emerald-500/25 transition-all gap-2 text-center cursor-pointer"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Claim ₹10,000 Discount on WhatsApp</span>
        </a>

        <!-- Secondary Form Anchor Button -->
        <a
          href="#enroll"
          id="exit-enroll-btn"
          class="w-full inline-flex items-center justify-center min-h-[46px] px-6 py-2.5 text-xs sm:text-sm font-extrabold text-heading bg-slate-100 hover:bg-slate-200 rounded-xl border border-slate-200 transition-all text-center cursor-pointer"
        >
          Check Batch Dates & Fee Structure →
        </a>
      </div>

      <!-- Trust Subtext -->
      <p class="text-[10px] text-slate-400 font-medium pt-1">
        Only 4 seats remaining for this batch • Offer valid today only
      </p>

    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('exit-modal');
    const modalCard = document.getElementById('exit-modal-card');
    const closeBtn = document.getElementById('close-exit-modal');
    const enrollBtn = document.getElementById('exit-enroll-btn');

    if (!modal) return;

    let hasShown = sessionStorage.getItem('upgrade_exit_modal_shown');

    function showModal() {
      if (hasShown) return;
      hasShown = true;
      sessionStorage.setItem('upgrade_exit_modal_shown', 'true');
      
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        if (modalCard) {
          modalCard.classList.remove('scale-95');
          modalCard.classList.add('scale-100');
        }
      }, 10);
    }

    function hideModal() {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      if (modalCard) {
        modalCard.classList.remove('scale-100');
        modalCard.classList.add('scale-95');
      }
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    // 1. Exit intent on desktop (mouse leaves towards top address bar)
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 10) {
        showModal();
      }
    });

    // 2. Timer trigger after 18 seconds for engaged mobile visitors
    setTimeout(() => {
      showModal();
    }, 18000);

    // Event Listeners for closing modal
    if (closeBtn) closeBtn.addEventListener('click', hideModal);
    if (enrollBtn) enrollBtn.addEventListener('click', hideModal);
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        hideModal();
      }
    });
  });
</script>
