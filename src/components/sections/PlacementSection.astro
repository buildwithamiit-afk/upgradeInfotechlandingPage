];

const infiniteRow1 = [...companiesRow1, ...companiesRow1, ...companiesRow1];
const infiniteRow2 = [...companiesRow2, ...companiesRow2, ...companiesRow2];
---

<section id="placement" class="py-16 md:py-24 bg-bg-alt border-y border-border relative overflow-hidden" aria-labelledby="placement-heading">
  
  <!-- Subtle Ambient Glow Overlay for Perceived Depth -->
  <div class="absolute top-0 inset-x-0 h-48 bg-gradient-to-b from-primary/5 to-transparent pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-primary/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 mb-12 md:mb-16">
    
    <!-- 1. Headline (Visual Hierarchy Priority 1) -->
    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-extrabold text-primary uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        PLACEMENTS
      </div>
      <h2 id="placement-heading" class="text-2xl sm:text-4xl lg:text-[2.65rem] font-black text-heading font-serif tracking-tight leading-tight">
        Our students don't just get certified.<br class="hidden sm:block" /> They get placed.
      </h2>
    </div>

    <!-- 2. Impact Statistics Strip (Visual Hierarchy Priority 2 - Layered Surface Elevation) -->
    <div class="max-w-5xl mx-auto mb-12 md:mb-16">
      <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xl shadow-slate-200/50 p-3.5 sm:p-6 transform transition-all duration-300 hover:border-primary/40 hover:shadow-2xl">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:divide-x divide-slate-100">
          {stats.map((stat, idx) => (
            <div class={`group flex flex-col sm:flex-row items-center justify-center text-center sm:text-left gap-2 sm:gap-3.5 p-2 sm:p-3.5 ${idx > 1 ? 'pt-3 sm:pt-3.5 lg:pt-2.5' : ''}`}>
              <div class="shrink-0 text-primary transition-transform duration-300 group-hover:scale-110">
                <Fragment set:html={stat.iconSvg} />
              </div>
              <div class="text-left">
                <p class="text-2xl sm:text-3xl font-black text-heading tracking-tight leading-none">
                  {stat.value}
                </p>
                <p class="text-[10px] sm:text-xs font-extrabold text-body tracking-wider uppercase mt-1 leading-tight">
                  {stat.label}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>

  <!-- 3. FULL-WIDTH TESTIMONIALS MARQUEE (Visual Hierarchy Priority 3 - Edge-to-Edge Surface Framing) -->
  <div class="w-full mb-16 md:mb-20 relative">
    <div class="max-w-7xl mx-auto px-4 text-center mb-8">
      <div class="inline-flex flex-col items-center mb-2">
        <span class="text-xs font-black tracking-widest uppercase text-heading">
          OUR TESTIMONIALS
        </span>
        <span class="w-7 h-0.5 bg-primary mt-1 rounded-full" aria-hidden="true"></span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-black text-heading font-serif tracking-tight">
        <span class="text-primary font-serif">Those Who</span> Acted And Transformed
      </h3>
    </div>

    <!-- Desktop View: Seamless Edge Overlays & Pure CSS Full-Width Marquee Track -->
    <div class="hidden md:block relative">
      <div class="absolute inset-y-0 left-0 w-20 sm:w-36 bg-gradient-to-r from-bg-alt/90 via-bg-alt/60 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute inset-y-0 right-0 w-20 sm:w-36 bg-gradient-to-l from-bg-alt/90 via-bg-alt/60 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-hidden relative py-3">
        <div class="animate-marquee flex gap-5 sm:gap-6">
          {infiniteTestimonials.map((rev) => (
            <div class="w-[310px] sm:w-[360px] shrink-0 bg-white rounded-3xl border border-slate-200/90 shadow-lg shadow-slate-200/40 p-6 sm:p-7 flex flex-col justify-between transform transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:border-primary/40 relative">
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <div class="w-13 h-13 rounded-full overflow-hidden border-2 border-primary/20 shadow-xs shrink-0 bg-primary/10 flex items-center justify-center">
                    <img src={rev.avatar} alt={rev.name} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                  <span class="text-xs font-black text-primary bg-primary/10 px-3 py-1.5 rounded-lg border border-primary/20">
                    {rev.package}
                  </span>
                </div>

                <h4 class="text-base font-black text-heading mb-1.5">
                  {rev.name}
                </h4>

                <p class="text-xs font-extrabold text-heading/80 mb-3">
                  {rev.role}
                </p>

                <!-- Company Logo (Enlarged & Clearly Visible) -->
                <div class="flex items-center mb-3.5">
                  <div class="inline-flex items-center justify-center bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200/90 shadow-2xs h-10 min-w-[100px] max-w-[160px]">
                    {rev.companyLogoImg ? (
                      <img src={rev.companyLogoImg} alt={rev.company} class="h-6 sm:h-7 max-w-[130px] w-auto object-contain shrink-0" loading="lazy" />
                    ) : (
                      <div class="flex items-center gap-1.5 text-xs font-black text-slate-700">
                        <Fragment set:html={rev.companyLogoSvg} />
                        <span>{rev.company}</span>
                      </div>
                    )}
                  </div>
                </div>

                <p class="text-xs sm:text-[13px] text-body font-normal leading-relaxed border-t border-slate-100 pt-3.5">
                  {rev.quote}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Mobile View: Fixed Non-Moving 2-Column Grid -->
    <div class="md:hidden grid grid-cols-2 gap-3 px-4 py-2">
      {testimonials.map((rev) => (
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-md p-3.5 flex flex-col justify-between relative">
          <div>
            <div class="flex items-center justify-between gap-1 mb-2">
              <div class="w-9 h-9 rounded-full overflow-hidden border border-primary/20 shadow-2xs shrink-0 bg-primary/10 flex items-center justify-center">
                <img src={rev.avatar} alt={rev.name} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <span class="text-[10px] font-black text-primary bg-primary/10 px-1.5 py-0.5 rounded-md border border-primary/20 shrink-0">
                {rev.package}
              </span>
            </div>

            <h4 class="text-xs font-black text-heading leading-tight mb-0.5 truncate">
              {rev.name}
            </h4>

            <p class="text-[10px] font-bold text-heading/75 mb-2 truncate">
              {rev.role}
            </p>

            <div class="flex items-center mb-2.5 min-h-[30px]">
              {rev.companyLogoImg ? (
                <img src={rev.companyLogoImg} alt={rev.company} class="h-6 sm:h-7 max-w-[105px] w-auto object-contain shrink-0" loading="lazy" />
              ) : (
                <div class="flex items-center gap-1.5 text-xs font-black text-slate-800">
                  <Fragment set:html={rev.companyLogoSvg} />
                  <span class="truncate">{rev.company}</span>
                </div>
              )}
            </div>

            <p class="text-[11px] text-body font-normal leading-snug border-t border-slate-100 pt-2 line-clamp-4">
              {rev.quote}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 3.5. DOWNLOAD DETAILED PLACEMENT REPORT CTA (Compact & Slim High-Converting Banner) -->
  <div class="max-w-5xl mx-auto px-4 my-6 sm:my-8">
    <div class="relative rounded-2xl bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white px-5 py-4.5 sm:px-7 sm:py-5 shadow-lg overflow-hidden border border-white/10 group">
      
      <!-- Ambient Background Glows -->
      <div class="absolute -top-16 -right-16 w-48 h-48 bg-accent/20 rounded-full blur-2xl pointer-events-none group-hover:bg-accent/30 transition-all duration-300" aria-hidden="true"></div>
      <div class="absolute -bottom-16 -left-16 w-48 h-48 bg-primary/25 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-3.5 sm:gap-6 text-center md:text-left">
        
        <!-- Left Column: Compact Text Content -->
        <div class="max-w-2xl">
          <div class="flex items-center justify-center md:justify-start gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/10 border border-white/15 text-[10px] sm:text-xs font-black text-accent uppercase tracking-wider">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Verified 2026 Batch Record</span>
            </span>
          </div>

          <h3 class="text-sm sm:text-base md:text-lg font-black text-white tracking-tight leading-snug mb-1">
            Want Complete Student Placement List & Salary Proofs?
          </h3>

          <p class="text-[11px] sm:text-xs text-slate-300 font-normal leading-snug">
            Get instant access to our official placement report featuring student profiles, salary packages, hiring companies, and 100% verified career transitions.
          </p>
        </div>

        <!-- Right Column: Slim Download Button -->
        <div class="shrink-0 w-full md:w-auto">
          <a
            href="#enroll"
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto min-h-[42px] px-6 py-2.5 text-xs sm:text-sm font-extrabold text-slate-900 bg-white hover:bg-slate-100 active:bg-slate-200 rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-accent cursor-pointer group/btn shrink-0"
          >
            <svg class="w-4 h-4 text-primary group-hover/btn:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download Detailed Placement Report</span>
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- 4. FULL-WIDTH HIRING COMPANIES MARQUEE (Visual Hierarchy Priority 4 - Clean White Container) -->
  <div class="w-full bg-white border-y border-slate-200/90 py-10 md:py-16 mb-14 relative shadow-sm">
    
    <!-- Edge Overlays -->
    <div class="absolute inset-y-0 left-0 w-12 sm:w-36 bg-gradient-to-r from-white via-white/80 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-y-0 right-0 w-12 sm:w-36 bg-gradient-to-l from-white via-white/80 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 text-center mb-6 md:mb-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-xs sm:text-sm font-black text-primary uppercase tracking-widest shadow-xs">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse" aria-hidden="true"></span>
        <span>500+ CORPORATE RECRUITER PARTNERS</span>
      </div>
    </div>

    <!-- Row 1: Left-to-Right Marquee (Mobile & Desktop) -->
    <div class="overflow-hidden relative mb-3.5 sm:mb-4 py-1">
      <div class="animate-marquee flex gap-3.5 sm:gap-6">
        {infiniteRow1.map((item) => (
          <div class="inline-flex items-center justify-center px-4 py-3 sm:px-8 sm:py-4 rounded-2xl bg-slate-50 border border-slate-200/90 shadow-sm hover:border-primary/40 hover:bg-primary/5 hover:-translate-y-0.5 transition-all duration-200 shrink-0 cursor-default h-14 sm:h-20 min-w-[120px] sm:min-w-[170px]">
            <img src={item.src} alt={item.alt} class="h-7 sm:h-12 max-w-[100px] sm:max-w-[150px] w-auto object-contain shrink-0" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: Right-to-Left Marquee (Mobile & Desktop) -->
    <div class="overflow-hidden relative py-1">
      <div class="animate-marquee-reverse flex gap-3.5 sm:gap-6">
        {infiniteRow2.map((item) => (
          <div class="inline-flex items-center justify-center px-4 py-3 sm:px-8 sm:py-4 rounded-2xl bg-slate-50 border border-slate-200/90 shadow-sm hover:border-primary/40 hover:bg-primary/5 hover:-translate-y-0.5 transition-all duration-200 shrink-0 cursor-default h-14 sm:h-20 min-w-[120px] sm:min-w-[170px]">
            <img src={item.src} alt={item.alt} class="h-7 sm:h-12 max-w-[100px] sm:max-w-[150px] w-auto object-contain shrink-0" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 5. FINAL PRIMARY CTA DESTINATION (Visual Hierarchy Priority 5 - Ambient Halo & Focus) -->
  <div class="text-center relative z-10 pt-2">
    <a
      href="#enroll"
      class="inline-flex items-center justify-center min-h-[50px] px-10 py-4 text-sm sm:text-base font-extrabold text-white bg-accent hover:bg-accent-hover active:bg-accent rounded-xl shadow-xl shadow-accent/25 transition-all transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-primary cursor-pointer"
    >
      See If You Qualify →
    </a>
  </div>

</section>
