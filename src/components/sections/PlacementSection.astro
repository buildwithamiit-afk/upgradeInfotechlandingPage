// Recruiter Companies Row 1
const companiesRow1 = [
  { name: "Galata Chemicals", src: "/PlacedCandidate/logo-galata-chemicals.png", alt: "Galata Chemicals Logo" },
  { name: "Parle", src: "/PlacedCandidate/parle_logo.webp", alt: "Parle Logo" },
  { name: "Go Colors", src: "/PlacedCandidate/go_colors.png", alt: "Go Colors Logo" },
  { name: "TCS", src: "/PlacedCandidate/Tata_Consultancy_Services_Logo.webp", alt: "Tata Consultancy Services Logo" },
  { name: "Infosys", src: "/PlacedCandidate/Infosys_log.webp", alt: "Infosys Logo" },
  { name: "LTIMindtree", src: "/PlacedCandidate/LTI_Lets_solve.webp", alt: "LTIMindtree Logo" }
];

// Recruiter Companies Row 2
const companiesRow2 = [
  { name: "Bosch", src: "/PlacedCandidate/Bosch-Logo.webp", alt: "Bosch Logo" },
  { name: "Infor", src: "/PlacedCandidate/Infor_logo.webp", alt: "Infor Logo" },
  { name: "Apprisia", src: "/PlacedCandidate/apprisia-logo.webp", alt: "Apprisia Logo" },
  { name: "Galata Chemicals", src: "/PlacedCandidate/logo-galata-chemicals.png", alt: "Galata Chemicals Logo" },
  { name: "Parle", src: "/PlacedCandidate/parle_logo.webp", alt: "Parle Logo" },
