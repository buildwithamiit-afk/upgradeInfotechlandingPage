    name: "Mrs. Isha Dixit",
    role: "SAP PP Consultant",
    company: "Parle",
    companyLogoImg: "/PlacedCandidate/parle_logo.webp",
    package: "13.5 LPA",
    avatar: "/Candidate_Image/isha_dixit.png",
    quote: "Working on live ticket-based projects and participating in mock interview sessions built immense confidence in me. The placement team supported me every step of the way to secure my placement at Parle."
  },
