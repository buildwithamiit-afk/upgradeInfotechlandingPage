---
// Masterclass CTA Section with Exact Website Brand Colors (#2563EB, #0B1B36, #F97316)
---

<section id="enroll" class="py-14 md:py-20 bg-bg-alt border-y border-border relative overflow-hidden" aria-labelledby="cta-heading">
  
  <!-- Subtle Soft Ambient Glow Overlay -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Brand Colored Banner Container -->
    <div class="max-w-5xl mx-auto bg-gradient-to-br from-surface-dark via-secondary to-surface-dark text-white rounded-3xl p-8 sm:p-12 md:p-14 text-center shadow-2xl relative overflow-hidden border border-surface-border">
      
      <!-- Top Ambient Brand Glows -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-primary/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-accent/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        
        <!-- Brand Urgency Tagline Capsule -->
        <p class="text-accent font-extrabold text-xs sm:text-sm tracking-widest uppercase mb-3 flex items-center justify-center gap-2">
          <span class="text-accent/60">—</span>
          <span>LIMITED SEATS</span>
          <span class="text-accent/60">—</span>
        </p>

        <!-- Main Headline -->
        <h2 id="cta-heading" class="text-2xl sm:text-3xl lg:text-4xl font-black text-white font-serif tracking-tight leading-tight mb-4">
          Seats for the Festive Offer batch are limited
        </h2>

        <!-- Subtext Paragraph -->
        <p class="text-slate-200 text-sm sm:text-base font-medium leading-relaxed max-w-xl mx-auto mb-8">
          Secure your seat today — get the full fee structure, batch calendar, and a free career roadmap call.
        </p>

        <!-- Two Centered Action Buttons (Brand Primary & Accent Colors) -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          
          <!-- Primary Brand CTA (Warm Orange #F97316 Button: Check My Eligibility →) -->
          <button
            type="button"
            class="placement-popup-trigger animate-shimmer-btn overflow-hidden relative w-full sm:w-auto inline-flex items-center justify-center min-h-[48px] px-8 py-3 text-sm sm:text-base font-bold text-white bg-accent hover:bg-accent-hover active:bg-accent rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-accent text-center cursor-pointer group"
          >
            <span>Book a Free Consultation</span>
          </button>

          <!-- Secondary WhatsApp CTA (WhatsApp Green Button) -->
          <a
            href="https://wa.me/917021348186?text=Hi%20Upgrade%20Infotech,%20I%20want%20to%20know%20more%20about%20SAP%20Festive%20Offer%20batches"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center min-h-[48px] px-8 py-3 text-sm sm:text-base font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-600 rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-emerald-600 text-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Chat on WhatsApp</span>
          </a>

        </div>

      </div>

    </div>

  </div>
</section>
