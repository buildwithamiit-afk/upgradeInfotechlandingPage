---
// Zero-JS Testimonials Section (Exact Reference Image Design + Company Logos + Continuous Auto-Scrolling Cards)
const reviews = [
  {
    id: "sonal-shinde",
    name: "Mrs. Sonal Shinde",
    role: "SAP FICO Consultant",
    company: "Galata Chemicals Ind Pvt Ltd",
    companyLogoImg: "/PlacedCandidate/logo-galata-chemicals.png",
    package: "14 LPA",
    avatar: "/Candidate_Image/sonal_shinde.png",
    quote: "The structured learning, real-world project scenarios, and constant guidance from experienced mentors helped me master SAP concepts thoroughly and successfully land my position at Galata Chemicals."
  },
  {
    id: "isha-dixit",
    name: "Mrs. Isha Dixit",
    role: "SAP PP Consultant",
    company: "Parle",
    companyLogoImg: "/PlacedCandidate/parle_logo.webp",
    package: "13.5 LPA",
    avatar: "/Candidate_Image/isha_dixit.png",
    quote: "Working on live ticket-based projects and participating in mock interview sessions built immense confidence in me. The placement team supported me every step of the way to secure my placement at Parle."
  },
  {
    id: "janhavi-tambat",
    name: "Ms. Janhavi Tambat",
    role: "SAP SF Consultant",
    company: "BB Infotech Solutions Pvt. Ltd.",
    companyLogoSvg: `<svg class="w-3.5 h-3.5 text-primary shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
    package: "12 LPA",
    avatar: "/Candidate_Image/Janhavi_tambat_bb_infotech_solutions_Sap_Sf-modified.png",
    quote: "Upgrade Infotech's curriculum is perfectly aligned with industry requirements. The hands-on training and dedicated mentorship made complex modules easy to understand and apply effectively."
  },
  {
    id: "pratiksha-kadam",
    name: "Ms. Pratiksha Kadam",
    role: "SAP FICO Consultant",
    company: "Jetking",
    companyLogoSvg: `<svg class="w-3.5 h-3.5 text-primary shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/></svg>`,
    package: "11.8 LPA",
    avatar: "/Candidate_Image/pratiksha_jetking_sap_fico-modified.png",
    quote: "The 1-on-1 resume preparation and technical mock interviews gave me the confidence needed to clear corporate placement drives. I am extremely grateful for the continuous guidance."
  },
  {
    id: "rohit-shewale",
    name: "Mr. Rohit Shewale",
    role: "SAP MM Consultant",
    company: "Go Colors",
    companyLogoImg: "/PlacedCandidate/go_colors.png",
    package: "14.5 LPA",
    avatar: "/Candidate_Image/Rohit_Go_colors_Sap_MM-modified.png",
    quote: "The practical knowledge shared by industry experts was invaluable. Tackling real business scenarios prepared me for the actual corporate workplace and helped me get placed at Go Colors."
  },
  {
    id: "neeraj-lengare",
    name: "Mr. Neeraj Lengare",
    role: "SAP PP & QM Consultant",
    company: "Infosys",
    companyLogoImg: "/PlacedCandidate/Infosys_log.webp",
    package: "15 LPA",
    avatar: "/Candidate_Image/Neeraj_infosys_sap_pp_and_qm-modified.png",
    quote: "Transitioning into a top MNC like Infosys was made smooth through Upgrade Infotech's comprehensive training, project practice, and dedicated placement assistance throughout the program."
  }
];

const infiniteReviews = [...reviews, ...reviews];

// Schema.org Review Data
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Upgrade Infotech SAP Training",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "2840"
  }
};
---

<section id="testimonials" class="py-14 md:py-20 bg-bg-alt border-y border-border relative overflow-hidden" aria-labelledby="testimonials-heading">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header (Exact Reference Styling) -->
    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-14">
      <div class="inline-flex flex-col items-center mb-3">
        <span class="text-xs font-black tracking-widest uppercase text-heading">
          OUR TESTIMONIALS
        </span>
        <span class="w-7 h-0.5 bg-primary mt-1 rounded-full" aria-hidden="true"></span>
      </div>

      <h2 id="testimonials-heading" class="text-3xl sm:text-4xl lg:text-[2.65rem] font-black text-heading font-serif tracking-tight leading-tight">
        <span class="text-primary font-serif">Those Who</span> Acted And Transformed
      </h2>
    </div>

    <!-- Continuous Auto-Scrolling Testimonials Track (Pure CSS Infinite Marquee) -->
    <div class="overflow-hidden relative py-2">
      <div class="animate-marquee flex gap-5">
        {infiniteReviews.map((rev) => (
          <div class="w-[300px] sm:w-[340px] shrink-0 bg-white rounded-3xl border border-slate-200/90 shadow-md shadow-slate-200/40 p-6 flex flex-col justify-between transform transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-primary/40 relative">
            
            <div>
              <!-- Top Row: Avatar & LinkedIn Badge -->
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="w-13 h-13 rounded-full overflow-hidden border-2 border-primary/20 shadow-xs shrink-0 bg-primary/10 flex items-center justify-center">
                  <img src={rev.avatar} alt={rev.name} class="w-full h-full object-cover" loading="lazy" />
                </div>
                <span class="text-xs font-black text-primary bg-primary/10 px-3 py-1.5 rounded-lg border border-primary/20">
                  {rev.package}
                </span>
              </div>

              <!-- Student Name -->
              <h3 class="text-base font-black text-heading mb-1.5">
                {rev.name}
              </h3>

              <!-- Job Title -->
              <p class="text-xs font-extrabold text-heading/80 mb-3">
                {rev.role}
              </p>

              <!-- Company Logo (Enlarged & No Company Text Name) -->
              <div class="flex items-center mb-3.5">
                <div class="inline-flex items-center justify-center bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200/90 shadow-2xs h-10 min-w-[100px] max-w-[160px]">
                  {rev.companyLogoImg ? (
                    <img src={rev.companyLogoImg} alt={rev.company} class="h-6 sm:h-7 max-w-[130px] w-auto object-contain shrink-0" loading="lazy" />
                  ) : (
                    <div class="flex items-center gap-1.5 text-xs font-black text-slate-700">
                      <Fragment set:html={rev.companyLogoSvg} />
                      <span>{rev.company}</span>
                    </div>
                  )}
                </div>
              </div>

              <!-- Testimonial Quote -->
              <p class="text-xs text-body font-normal leading-relaxed border-t border-slate-100 pt-3.5">
                {rev.quote}
              </p>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>
</section>
