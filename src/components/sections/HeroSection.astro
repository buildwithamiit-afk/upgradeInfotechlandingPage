---
// High-Converting Multi-Step Lead Capture Hero Component
const recruiterLogos = [
  { src: "/Tata_Consultancy_Services_Logo.webp", alt: "TCS Logo", height: "h-8 sm:h-10" },
  { src: "/Infosys_log.webp", alt: "Infosys Logo", height: "h-7 sm:h-9" },
  { src: "/LTI_Lets_solve.webp", alt: "LTI Mindtree Logo", height: "h-7 sm:h-9" },
  { src: "/Bosch-Logo.webp", alt: "Bosch Logo", height: "h-7 sm:h-9" },
  { src: "/Infor_logo.webp", alt: "Infor Logo", height: "h-7 sm:h-9" },
  { src: "/apprisia-logo.webp", alt: "Apprisia Logo", height: "h-7 sm:h-9" },
];

const infiniteRecruiterLogos = [...recruiterLogos, ...recruiterLogos, ...recruiterLogos];
---

<section class="relative pt-4 pb-12 md:pt-8 md:pb-16 overflow-hidden bg-bg-alt border-b border-border" aria-label="Hero Introduction">
  <!-- Subtle Background Grid Overlay -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none opacity-40" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Centered Urgency Banner Pill -->
    <div class="flex justify-center mb-4 sm:mb-6">
      <div class="inline-flex flex-wrap items-center justify-center gap-1.5 sm:gap-2.5 px-3.5 sm:px-4 py-1.5 rounded-full bg-primary-light border border-border text-[11px] sm:text-xs font-bold text-heading shadow-xs text-center">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse shrink-0" aria-hidden="true"></span>
        <span class="px-2 py-0.5 rounded-full bg-accent text-white text-[10px] sm:text-[11px] font-black uppercase tracking-wider">
          Festive Offer
        </span>
        <span class="font-bold text-heading">
          Only <strong class="text-accent font-black text-xs sm:text-sm">4 seats left</strong> in this batch
        </span>
      </div>
    </div>

    <!-- Main 2-Column Hero Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-start mb-10 sm:mb-12 lg:mb-16">
      
      <!-- Left Column: Copy, Headlines, Trust Bar & Action Buttons -->
      <div class="lg:col-span-7 space-y-3.5 sm:space-y-4 text-left">
        
        <!-- Pre-heading Tagline -->
        <div class="text-xs sm:text-sm md:text-base font-black tracking-wider text-primary uppercase flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-primary" aria-hidden="true"></span>
          <span>SAP AUTHORISED TRAINING · MUMBAI</span>
        </div>

        <!-- H1 Heading -->
        <h1 class="text-2xl sm:text-4xl lg:text-[2.75rem] font-black text-heading tracking-tight leading-[1.18]">
          Get SAP Certified. <span class="text-primary font-black">Get Job-Ready in 90 Days.</span>
        </h1>

        <!-- Subheadline Copy 1 & 2 -->
        <div class="space-y-2 max-w-2xl">
          <p class="text-xs sm:text-base text-body font-semibold leading-relaxed">
            Learn SAP from practising consultants and work on real, ticket-based projects so you’re prepared for the kind of work companies actually hire for.
          </p>
          <p class="text-xs sm:text-sm text-body/90 font-medium leading-relaxed">
            Choose from <strong class="text-heading font-extrabold">SAP FICO, MM, SD, HR & ABAP</strong> with classroom training in <strong class="text-heading font-extrabold">Andheri, Ghatkopar & Vashi</strong>, or join live online from anywhere.
          </p>
        </div>

        <!-- Single Horizontal Trust Bar (2x2 Grid on Mobile) -->
        <div class="pt-1 pb-1">
          <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 sm:gap-4 text-xs font-bold text-heading">
            <div class="flex items-center gap-1.5 bg-white sm:bg-transparent p-2 sm:p-0 rounded-xl border sm:border-0 border-border shadow-2xs sm:shadow-none">
              <span class="text-accent text-sm">⭐</span>
              <span>4.8/5 from 380+ Reviews</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white sm:bg-transparent p-2 sm:p-0 rounded-xl border sm:border-0 border-border shadow-2xs sm:shadow-none">
              <span class="text-primary text-sm">🏆</span>
              <span>12+ Years of Training Experience</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white sm:bg-transparent p-2 sm:p-0 rounded-xl border sm:border-0 border-border shadow-2xs sm:shadow-none">
              <span class="text-accent text-sm">🎯</span>
              <span>94% Placement Rate</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white sm:bg-transparent p-2 sm:p-0 rounded-xl border sm:border-0 border-border shadow-2xs sm:shadow-none">
              <span class="text-primary text-sm">💳</span>
              <span>No-Cost EMI Available</span>
            </div>
          </div>
        </div>

        <!-- Left Action Buttons (Primary vs Secondary Differentiation) -->
        <div class="pt-1 space-y-2">
          <h3 class="text-sm font-black text-heading uppercase tracking-wide">
            Your SAP Career Can Start Here.
          </h3>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <!-- Primary CTA: Solid Primary Fill -->
            <button
              type="button"
              class="placement-popup-trigger animate-shimmer-btn overflow-hidden relative w-full sm:w-auto inline-flex items-center justify-center min-h-[46px] px-6 py-2.5 text-sm font-bold text-white bg-primary hover:bg-primary-hover active:bg-primary rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-primary text-center group cursor-pointer"
            >
              <!-- Highlighted Phone Icon Circular Badge -->
              <span class="w-6 h-6 rounded-full bg-white/20 text-white flex items-center justify-center mr-2 shadow-xs shrink-0 animate-pulse">
                <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </span>
              <span>Book a Free Consultation</span>
            </button>

            <!-- Secondary CTA: Outline/Ghost Button -->
            <a
              href="#curriculum"
              class="w-full sm:w-auto inline-flex items-center justify-center min-h-[44px] px-6 py-2 text-sm font-semibold text-heading bg-white hover:bg-slate-50 border border-slate-200 hover:border-slate-300 rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-primary text-center"
            >
              <span>View Courses & Fees</span>
            </a>
          </div>

          <!-- Microcopy under CTAs -->
          <p class="text-[11px] font-medium text-body/90 italic flex items-center gap-1">
            <span>⚡</span>
            <span>Limited seats available for the upcoming batch.</span>
          </p>
        </div>

      </div>

      <!-- Right Column: 2-Field High-Converting Lead Capture Form Card -->
      <div class="lg:col-span-5 relative mt-4 lg:mt-0">
        
        <!-- Professional Form Card -->
        <div id="enroll" class="bg-gradient-to-br from-primary to-accent sm:bg-none sm:bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-primary sm:border-slate-200 overflow-hidden relative transform transition-all duration-300 hover:shadow-[0_20px_40px_rgba(102,51,153,0.12)] hover:-translate-y-1">
          
          <!-- Top Accent Line -->
          <div class="h-1.5 bg-white/30 sm:bg-gradient-to-r sm:from-primary sm:to-accent" aria-hidden="true"></div>

          <!-- Lead Form Body -->
          <div class="p-6 sm:p-8">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h2 class="text-xl sm:text-2xl font-black text-white sm:text-heading tracking-tight text-left flex items-center gap-2">
                  <span class="text-white sm:text-primary text-xl">⚡</span> Free Career Roadmap
                </h2>
                <p class="text-xs sm:text-sm text-white/90 sm:text-body mt-1.5 text-left font-medium">
                  Get fees, batch dates & eligibility structure in 30 mins.
                </p>
              </div>
              <span class="text-[10px] font-extrabold px-2.5 py-1 rounded-md bg-white/20 sm:bg-emerald-50 text-white sm:text-emerald-700 uppercase border border-white/30 sm:border-emerald-200 whitespace-nowrap shrink-0 mt-1 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 sm:bg-emerald-500 animate-pulse"></span> Free Access
              </span>
            </div>

            <form id="hero-lead-form" action="/api/lead" method="POST" class="space-y-3">
              <!-- Invisible Honeypot Field for Anti-Bot Protection -->
              <input
                type="text"
                name="website_url"
                id="hero-lead-website-url"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="absolute -left-[9999px] opacity-0 pointer-events-none h-0 w-0"
              />

              <!-- All 4 Fields in a Clean Balanced 2-Column Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
                <!-- Full Name Input -->
                <div>
                  <label for="hero-lead-name" class="block text-[11px] font-extrabold uppercase text-white sm:text-heading mb-1">
                    Full Name <span class="text-accent">*</span>
                  </label>
                  <input
                    type="text"
                    id="hero-lead-name"
                    name="name"
                    required
                    placeholder="Enter full name"
                    class="w-full h-10 sm:h-11 px-3.5 rounded-xl border border-white/20 sm:border-slate-300 text-sm font-semibold focus:ring-2 focus:ring-white sm:focus:ring-primary focus:border-white sm:focus:border-primary focus:outline-none transition-all bg-white text-heading placeholder:text-slate-400"
                  />
                </div>

                <!-- Mobile Number Input -->
                <div>
                  <label for="hero-lead-phone" class="block text-[11px] font-extrabold uppercase text-white sm:text-heading mb-1">
                    Mobile Number <span class="text-accent">*</span>
                  </label>
                  <input
                    type="tel"
                    id="hero-lead-phone"
                    name="phone"
                    required
                    pattern="[0-9]{10}"
                    maxlength="10"
                    placeholder="10-digit mobile number"
                    class="w-full h-10 sm:h-11 px-3.5 rounded-xl border border-white/20 sm:border-slate-300 text-sm font-semibold focus:ring-2 focus:ring-white sm:focus:ring-primary focus:border-white sm:focus:border-primary focus:outline-none transition-all bg-white text-heading placeholder:text-slate-400"
                  />
                </div>

                <!-- Course Selection -->
                <div>
                  <label for="hero-lead-course" class="block text-[11px] font-extrabold uppercase text-white sm:text-heading mb-1">
                    Course Interested In <span class="text-accent">*</span>
                  </label>
                  <select
                    id="hero-lead-course"
                    name="course"
                    class="w-full h-10 sm:h-11 px-3 rounded-xl border border-white/20 sm:border-slate-300 text-xs sm:text-sm font-semibold focus:ring-2 focus:ring-white sm:focus:ring-primary focus:border-white sm:focus:border-primary focus:outline-none transition-all bg-white text-heading cursor-pointer"
                  >
                    <option value="sap-fico" selected>SAP FICO (Finance)</option>
                    <option value="sap-mm">SAP MM (Materials)</option>
                    <option value="sap-sd">SAP SD (Sales)</option>
                    <option value="sap-hr">SAP HR / HCM</option>
                    <option value="sap-abap">SAP ABAP</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <!-- Preferred Location -->
                <div>
                  <label for="hero-lead-location" class="block text-[11px] font-extrabold uppercase text-white sm:text-heading mb-1">
                    Preferred Location <span class="text-accent">*</span>
                  </label>
                  <select
                    id="hero-lead-location"
                    name="location"
                    class="w-full h-10 sm:h-11 px-3 rounded-xl border border-white/20 sm:border-slate-300 text-xs sm:text-sm font-semibold focus:ring-2 focus:ring-white sm:focus:ring-primary focus:border-white sm:focus:border-primary focus:outline-none transition-all bg-white text-heading cursor-pointer"
                  >
                    <option value="andheri" selected>Andheri Classroom</option>
                    <option value="ghatkopar">Ghatkopar Classroom</option>
                    <option value="vashi">Vashi Classroom</option>
                    <option value="live-online">Live Online Batch</option>
                  </select>
                </div>
              </div>

              <!-- Privacy Microcopy DIRECTLY ABOVE CTA BUTTON -->
              <div class="flex items-center justify-center gap-1.5 text-[11px] text-white sm:text-primary font-bold bg-white/20 sm:bg-primary-light py-1.5 px-3 rounded-lg border border-white/30 sm:border-primary/20">
                <svg class="w-3.5 h-3.5 text-white sm:text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <span>100% Confidential · No Spam · Response in 30 mins</span>
              </div>

              <!-- Value-Packed Primary Submit CTA Button -->
              <button
                type="submit"
                id="hero-form-submit-btn"
                class="w-full min-h-[44px] mt-1 px-4 py-2.5 text-sm font-bold text-primary sm:text-white bg-white sm:bg-primary hover:bg-slate-100 sm:hover:bg-primary-hover active:bg-slate-200 sm:active:bg-primary rounded-lg shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-white sm:focus:ring-primary cursor-pointer group flex items-center justify-center"
              >
                Get Fee & Free Demo Class <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
              </button>
            </form>

            <!-- Recruiter Logos Strip Directly Below Form (Continuous Slow Moving Marquee) -->
            <div class="mt-4 pt-3.5 border-t border-white/20 sm:border-slate-100">
              <p class="text-[11px] font-black uppercase tracking-wider text-white sm:text-heading text-center mb-2.5">
                Students Placed At Top Companies
              </p>
              <div class="bg-white sm:bg-slate-50/90 py-3 rounded-xl border border-white/20 sm:border-slate-200/90 overflow-hidden relative">
                <!-- Edge Overlay Gradients for smooth fade -->
                <div class="absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-white sm:from-slate-50 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>
                <div class="absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-white sm:from-slate-50 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

                <!-- Slow Moving Continuous Marquee Track -->
                <div class="animate-marquee flex items-center gap-6 sm:gap-8">
                  {infiniteRecruiterLogos.map((logo) => (
                    <img
                      src={logo.src}
                      alt={logo.alt}
                      class={`${logo.height} w-auto object-contain hover:scale-105 transition-transform shrink-0`}
                    />
                  ))}
                </div>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>

    <!-- Ultra-Compact Metric Cards Bar with Visual Icons -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4 max-w-5xl mx-auto relative z-20">
      
      <!-- Card 1: Students Trained -->
      <div class="bg-white p-3.5 sm:p-4.5 rounded-xl sm:rounded-2xl border border-slate-200/90 shadow-md shadow-slate-200/40 text-center transform transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:border-primary/40">
        <div class="text-xl mb-1">🎓</div>
        <p class="text-2xl sm:text-3xl font-black text-heading leading-none tracking-tight">
          2,840<span class="text-accent font-extrabold ml-0.5">+</span>
        </p>
        <p class="text-[11px] sm:text-xs font-bold text-body mt-1">Students Trained</p>
      </div>

      <!-- Card 2: Recruiter Partners -->
      <div class="bg-white p-3.5 sm:p-4.5 rounded-xl sm:rounded-2xl border border-slate-200/90 shadow-md shadow-slate-200/40 text-center transform transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:border-primary/40">
        <div class="text-xl mb-1">🏢</div>
        <p class="text-2xl sm:text-3xl font-black text-heading leading-none tracking-tight">
          320<span class="text-accent font-extrabold ml-0.5">+</span>
        </p>
        <p class="text-[11px] sm:text-xs font-bold text-body mt-1">Recruiter Partners</p>
      </div>

      <!-- Card 3: Placement Rate -->
      <div class="bg-white p-3.5 sm:p-4.5 rounded-xl sm:rounded-2xl border border-slate-200/90 shadow-md shadow-slate-200/40 text-center transform transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:border-primary/40">
        <div class="text-xl mb-1">🎯</div>
        <p class="text-2xl sm:text-3xl font-black text-heading leading-none tracking-tight">
          94%
        </p>
        <p class="text-[11px] sm:text-xs font-bold text-body mt-1">Placement Rate</p>
      </div>

      <!-- Card 4: Years Experience -->
      <div class="bg-white p-3.5 sm:p-4.5 rounded-xl sm:rounded-2xl border border-slate-200/90 shadow-md shadow-slate-200/40 text-center transform transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:border-primary/40">
        <div class="text-xl mb-1">🏆</div>
        <p class="text-2xl sm:text-3xl font-black text-heading leading-none tracking-tight">
          12<span class="text-accent font-extrabold ml-0.5">+</span>
        </p>
        <p class="text-[11px] sm:text-xs font-bold text-body mt-1">Years Experience</p>
      </div>

    </div>

  </div>
</section>

<!-- Client Script for Lead Form CRM API Sync with Invisible Anti-Bot Protection -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('hero-lead-form');
    const nameInput = document.getElementById('hero-lead-name');
    const phoneInput = document.getElementById('hero-lead-phone');
    const locationInput = document.getElementById('hero-lead-location');
    const courseInput = document.getElementById('hero-lead-course');
    const honeypotInput = document.getElementById('hero-lead-website-url');
    const submitBtn = document.getElementById('hero-form-submit-btn');

    const CRM_API_URL = 'https://dashboard.conceptninjas.com/services/web/syncLead/NUo5VXowRTYwZU1xdHVmdUw1WlQvdz09';
    const formInitTime = Date.now();
    const MIN_SUBMISSION_TIME_MS = 3000; // 3 seconds threshold
    const RATE_LIMIT_WINDOW_MS = 30000;  // 30 seconds cooldown
    let isSubmitting = false;
    const originalBtnText = submitBtn ? submitBtn.innerHTML : 'Get Fee & Free Demo Class →';

    async function sendLeadToCRM(payload) {
      try {
        const res = await fetch(CRM_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        return res.ok;
      } catch (err) {
        console.error('CRM sync error:', err);
        return false;
      }
    }

    if (form && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Submission Lock: Prevent duplicate / concurrent submissions
        if (isSubmitting) return;

        // 2. Honeypot check: If filled, silently drop and simulate completion
        if (honeypotInput && honeypotInput.value.trim() !== '') {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting Details...';
          setTimeout(() => {
            window.location.href = '/thank-you';
          }, 800);
          return;
        }

        // 3. Minimum interaction time check: Humans take > 3 seconds to complete the form
        const elapsedTime = Date.now() - formInitTime;
        if (elapsedTime < MIN_SUBMISSION_TIME_MS) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting Details...';
          setTimeout(() => {
            window.location.href = '/thank-you';
          }, 1000);
          return;
        }

        // 4. Client-side Rate Limiting (30s window per browser)
        try {
          const lastSubmission = localStorage.getItem('lead_form_last_submission');
          if (lastSubmission && (Date.now() - parseInt(lastSubmission, 10)) < RATE_LIMIT_WINDOW_MS) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting Details...';
            setTimeout(() => {
              window.location.href = '/thank-you';
            }, 600);
            return;
          }
        } catch (storageErr) {
          // localStorage disabled or unavailable; proceed gracefully
        }

        // 5. Input Validation
        const nameVal = nameInput ? nameInput.value.trim().slice(0, 100) : '';
        const rawPhone = phoneInput ? phoneInput.value.trim() : '';
        const phoneDigits = rawPhone.replace(/\D/g, '');
        const locVal = locationInput ? locationInput.value : 'Andheri';
        const courseVal = courseInput ? courseInput.value : 'SAP FICO';

        if (nameVal.length < 2 || phoneDigits.length < 10) {
          alert('Please enter your full name (at least 2 characters) and a valid 10-digit mobile number.');
          return;
        }

        // Lock form during submission
        isSubmitting = true;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Details...';

        try {
          await sendLeadToCRM({
            name: nameVal,
            email: 'info@upgradeinfotech.com',
            mobile: phoneDigits.slice(-10),
            course: courseVal,
            location: locVal,
            message: `New lead from Upgrade Infotech Landing Page (${courseVal} - ${locVal})`,
            source: 'Upgrade Infotech Landing Page'
          });

          // Record last submission timestamp
          try {
            localStorage.setItem('lead_form_last_submission', Date.now().toString());
          } catch (storageErr) {}

          // Redirect to Thank You page
          window.location.href = '/thank-you';
        } catch (err) {
          console.error('Submission failed:', err);
          // Reset lock on failure
          isSubmitting = false;
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnText;
          alert('Something went wrong while submitting. Please try again or call us directly.');
        }
      });
    }
  });
</script>
