---
// Minimal, Balanced, 2-Column FAQ Component
const faqs = [
  {
    q: "What is the difference between SAP ECC and SAP S/4HANA training?",
    a: "SAP ECC is the legacy ERP system, whereas SAP S/4HANA is SAP's next-generation in-memory ERP suite with real-time analytics and modern Fiori UX. At Upgrade Infotech, we train you directly on live SAP S/4HANA ERP servers so you are 100% prepared for modern enterprise job roles."
  },
  {
    q: "Can I learn SAP without a technical/programming background?",
    a: "Yes, absolutely! Functional SAP modules like SAP FICO, SAP MM, SAP SD, and SAP HR / SuccessFactors require zero coding background and are ideal for finance, commerce, management, and non-tech graduates. Technical modules like SAP ABAP start from core programming fundamentals."
  },
  {
    q: "Is the certificate recognised internationally?",
    a: "Yes! Upgrade Infotech's certification and global SAP exam preparation align with international SAP standards, enabling our alumni to land roles at top MNCs in India, UAE, USA, UK, and across global tech hubs."
  },
  {
    q: "What happens if I miss a class?",
    a: "You get FREE access to repeat batches, session backup recordings, and 1-on-1 doubt clearing support with your certified SAP trainer at any of our Andheri, Ghatkopar, or Vashi centers, or live online."
  },
  {
    q: "Do you offer EMI or an education loan tie-up?",
    a: "Yes! We offer flexible No-Cost EMI options starting from ₹3,999/month and have direct education loan tie-up options with leading banking partners for hassle-free 0% interest installments."
  },
  {
    q: "What is your refund/cancellation policy?",
    a: "We maintain 100% transparent admission and batch scheduling policies. You can attend our initial orientation & trial session to experience the training quality firsthand before committing to your batch seat lock."
  }
];

// FAQ Schema (JSON-LD) for Search Engine Rich Snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section id="faq" class="py-16 md:py-24 bg-[#FAFAFA] border-y border-slate-100 relative overflow-hidden" aria-labelledby="faq-heading">
  
  <!-- JSON-LD FAQ Schema for Google Rich Results -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 1. Centered Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-14">
      <div class="text-[11px] sm:text-[12px] font-bold text-amber-600 uppercase tracking-widest mb-3">
        Help Center
      </div>
      <h2 id="faq-heading" class="text-4xl sm:text-5xl lg:text-[3.25rem] font-serif font-bold text-slate-900 tracking-tight leading-tight mb-5">
        Everything You Need to Know
      </h2>
      <p class="text-base sm:text-lg text-slate-500 font-medium leading-relaxed">
        From batch schedules to curriculum details, find answers to the<br class="hidden sm:block"/> questions our students ask most often.
      </p>
    </div>

    <!-- 2. Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      
      <!-- Left Column: Image Container -->
      <div class="w-full relative rounded-lg overflow-hidden border border-slate-100 bg-white shadow-sm flex items-center justify-center">
        <img src="/Upgrade_infotech_faq.png" alt="Upgrade Infotech FAQ Support" class="w-full h-auto max-h-[800px] object-cover" />
      </div>

      <!-- Right Column: Accordions & Contact Block -->
      <div class="flex flex-col h-full">
        
        <!-- Accordion List -->
        <div class="border-t border-slate-200">
          {faqs.map((faq) => (
            <details class="group border-b border-slate-200 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between py-5 sm:py-6 cursor-pointer select-none">
                <h3 class="text-base sm:text-[17px] font-bold text-slate-800 pr-4">
                  {faq.q}
                </h3>
                <div class="w-5 h-5 shrink-0 text-slate-400 group-open:hidden flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                </div>
                <div class="w-5 h-5 shrink-0 text-slate-400 hidden group-open:flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4"/></svg>
                </div>
              </summary>
              <div class="pb-6 pr-8">
                <p class="text-sm sm:text-[15px] text-slate-600 font-medium leading-relaxed">
                  {faq.a}
                </p>
              </div>
            </details>
          ))}
        </div>

        <!-- Contact Support Block (Directly below FAQs) -->
        <div class="mt-8 lg:mt-12">
          <h4 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">
            Need More Information?
          </h4>
          <p class="text-sm sm:text-base text-slate-500 font-medium mb-6">
            Get in touch with our team for quick answers and hassle-free enrollment.
          </p>
          <a
            href="tel:+917021348186"
            class="inline-flex items-center justify-center px-8 py-3.5 text-xs sm:text-sm font-bold text-white bg-slate-900 hover:bg-black rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-slate-900 uppercase tracking-widest shadow-sm"
          >
            Contact Support
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
