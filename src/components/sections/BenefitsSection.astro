---
// Masterclass Zero-JS 3-Equal-Column Comparison Table (Criteria, Typical Other Institutes, UPGRADE INFOTECH)
const comparisonRows = [
  {
    criteria: "Batch size",
    others: "Large batches",
    upgrade: "Small, personalised"
  },
  {
    criteria: "Locations",
    others: "Usually 1 location",
    upgrade: "Andheri, Ghatkopar, Vashi + Online"
  },
  {
    criteria: "Placement support",
    others: "Varies",
    upgrade: "Dedicated team, active interview scheduling"
  },
  {
    criteria: "EMI / loan options",
    others: "Not always disclosed",
    upgrade: "Yes, no-cost EMI"
  },
  {
    criteria: "Trainer background",
    others: "Varies",
    upgrade: "Currently practising SAP consultants"
  }
];
---

<section id="compare" class="py-14 md:py-20 bg-slate-50/80 border-y border-slate-200/90 relative overflow-hidden" aria-labelledby="compare-heading">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 1. Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-extrabold text-primary uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        COMPARE
      </div>
      <h2 id="compare-heading" class="text-3xl sm:text-4xl lg:text-[2.65rem] font-black text-heading font-serif tracking-tight leading-tight">
        Upgrade Infotech vs. other Mumbai institutes
      </h2>
    </div>

    <!-- 2. Single 3-Column Table (Fits 100% Width on Mobile Without Horizontal Scroll) -->
    <div class="max-w-5xl mx-auto w-full">
      <div class="bg-white rounded-2xl sm:rounded-3xl border sm:border-2 border-primary shadow-xl sm:shadow-2xl relative w-full overflow-hidden">
        
        <!-- Table Header Row (3 Equal Columns) -->
        <div class="grid grid-cols-3 bg-[#0B1B36] text-white text-[10px] sm:text-xs md:text-sm font-black uppercase tracking-wider text-center divide-x divide-slate-700/60">
          
          <!-- Column 1: Criteria -->
          <div class="p-2 sm:p-5 flex items-center justify-center text-slate-300">
            Criteria
          </div>

          <!-- Column 2: Typical Other Institutes -->
          <div class="p-2 sm:p-5 flex items-center justify-center text-slate-400">
            <span class="hidden sm:inline">Typical </span>Other Institutes
          </div>

          <!-- Column 3: UPGRADE INFOTECH -->
          <div class="p-2 sm:p-5 bg-primary/20 flex items-center justify-center text-emerald-400">
            <span class="text-white font-extrabold">UPGRADE INFOTECH</span>
          </div>

        </div>

        <!-- Table Body Rows (5 Rows, 3 Equal Columns with Vertical Dividers) -->
        <div class="divide-y divide-slate-200/80">
          {comparisonRows.map((row) => (
            <div class="grid grid-cols-3 text-[11px] sm:text-xs md:text-sm items-stretch divide-x divide-slate-200/80">
              
              <!-- 1. Criteria (33.33% Width) -->
              <div class="p-2 sm:p-5 font-extrabold text-heading bg-slate-50/50 flex items-center leading-tight">
                {row.criteria}
              </div>

              <!-- 2. Typical Other Institutes (33.33% Width) -->
              <div class="p-2 sm:p-5 font-medium text-slate-500 flex items-center gap-1 sm:gap-2 leading-tight">
                <span class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-[9px] sm:text-[10px] shrink-0 font-extrabold border border-slate-200">✕</span>
                <span>{row.others}</span>
              </div>

              <!-- 3. UPGRADE INFOTECH (33.33% Width - Highlighted Brand Cell) -->
              <div class="p-2 sm:p-5 font-black text-heading bg-blue-50/50 flex items-center gap-1 sm:gap-2 leading-tight">
                <span class="w-3.5 h-3.5 sm:w-4.5 sm:h-4.5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[9px] sm:text-[11px] shrink-0 font-extrabold shadow-xs">✓</span>
                <span>{row.upgrade}</span>
              </div>

            </div>
          ))}
        </div>

        <!-- Table Footer Row (Primary Action CTA inside Column 3) -->
        <div class="grid grid-cols-3 bg-slate-50/80 border-t border-slate-200/80 divide-x divide-slate-200/80 items-center">
          <div class="p-2 sm:p-4 col-span-2 text-[10px] sm:text-xs md:text-sm font-extrabold text-slate-500 text-center sm:text-left sm:pl-6 leading-tight">
            Certified trainers • 100% Placement assistance • Andheri, Ghatkopar, Vashi & Online
          </div>
          <div class="p-1.5 sm:p-4 text-center bg-blue-50/30">
            <a
              href="#enroll"
              class="w-full inline-flex items-center justify-center min-h-[38px] sm:min-h-[44px] px-2 sm:px-4 py-2 sm:py-3 text-[10px] sm:text-xs md:text-sm font-extrabold text-white bg-accent hover:bg-accent-hover active:bg-accent rounded-lg sm:rounded-xl shadow-md shadow-accent/20 transition-all text-center cursor-pointer"
            >
              Claim Spot →
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
