---
// Minimal, Balanced 4-Card Features Grid Component
const benefits = [
  {
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
    title: "Job-Oriented Curriculum",
    desc: "Designed and taught by working SAP consultants, so every concept ties back to a real business scenario, not just slides."
  },
  {
    icon: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    title: "Guaranteed Interviews",
    desc: "Once you complete training, you enter our placement pool and we actively schedule interviews with hiring partners."
  },
  {
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
    title: "Small, Personal Batches",
    desc: "We avoid overcrowded classrooms to ensure you get 1-on-1 attention and direct doubt-clearing sessions."
  },
  {
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    title: "No-Cost EMI & Loans",
    desc: "Quality SAP education made affordable with flexible No-Cost instalment plans so fees are never a hurdle."
  }
];
---

<section id="features" class="py-16 md:py-24 bg-[#FAFAFA] border-y border-slate-100 relative overflow-hidden" aria-labelledby="features-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 1. Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16">
      <div class="text-[11px] sm:text-[12px] font-bold text-primary uppercase tracking-widest mb-3">
        Why Upgrade Infotech
      </div>
      <h2 id="features-heading" class="text-4xl sm:text-5xl lg:text-[3.25rem] font-serif font-bold text-slate-900 tracking-tight leading-tight mb-5">
        Why 2,840+ Students Chose Us to Launch Their SAP Careers
      </h2>
      <p class="text-base sm:text-lg text-slate-500 font-medium leading-relaxed max-w-2xl mx-auto">
        Not just certification: a full runway from classroom to placement, built by people who still work in SAP.
      </p>
    </div>

    <!-- 2. Four-Column Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 mb-16">
      {benefits.map((benefit) => (
        <div class="bg-white rounded-lg p-8 shadow-sm border border-slate-100 hover:shadow-md transition-shadow group">
          <!-- Icon Circle -->
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={benefit.icon} />
            </svg>
          </div>
          <!-- Card Content -->
          <h3 class="text-lg font-bold text-slate-900 mb-3 font-serif tracking-tight">
            {benefit.title}
          </h3>
          <p class="text-[13.5px] text-slate-500 leading-relaxed font-medium">
            {benefit.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- 3. Bottom Wide CTA Box -->
    <div class="bg-white rounded-lg shadow-sm border border-slate-100 p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6 max-w-5xl mx-auto">
      <div class="text-center md:text-left flex-grow">
        <h3 class="text-2xl sm:text-[28px] font-bold text-slate-900 font-serif tracking-tight mb-3">
          Ready for Your Personal Consultation?
        </h3>
        <p class="text-sm sm:text-base text-slate-500 font-medium">
          Book your free SAP career counseling session today and get up to <strong class="text-slate-800">20% OFF</strong> on early enrollment.
        </p>
      </div>
      <div class="shrink-0 w-full md:w-auto">
        <button
          type="button"
          class="placement-popup-trigger w-full md:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 text-xs sm:text-sm font-bold text-white bg-primary hover:bg-primary-hover rounded-full transition-all focus:outline-none focus:ring-2 focus:ring-primary uppercase tracking-widest shadow-sm hover:-translate-y-0.5 group"
        >
          <span>Book Free Consultation</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </div>
    </div>

  </div>
</section>
