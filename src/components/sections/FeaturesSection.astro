---
// Senior UI/UX High-Converting Features Component (Title Beside Clean Icon + Description Below)
const features = [
  {
    title: "Job-Oriented Curriculum",
    description: "Designed and taught by working SAP consultants, so every concept ties back to a real business scenario, not just slides.",
    iconSvg: `<svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`
  },
  {
    title: "Guaranteed Interview Opportunities",
    description: "Once you complete training, you enter our placement pool and we actively schedule interviews with hiring partners.",
    iconSvg: `<svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>`
  },
  {
    title: "Hands-On Live Projects",
    description: "Practice on live-style SAP environments with real, ticket-based scenarios instead of theory-only sessions.",
    iconSvg: `<svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`
  },
  {
    title: "Small Batch Sizes",
    description: "Personal attention in every session, classroom or online, so no doubt goes unanswered.",
    iconSvg: `<svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`
  },
  {
    title: "EMI & Education Loan Options",
    description: "Flexible, no-cost instalment plans so fees are never the reason you delay your SAP career.",
    iconSvg: `<svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`
  },
  {
    title: "24×7 Doubt Support",
    description: "Query resolution beyond classroom hours, plus resume, mock-interview & soft-skills coaching built in.",
    iconSvg: `<svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  }
];
---

<section id="features" class="py-10 md:py-14 bg-bg-alt border-y border-border" aria-labelledby="features-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl text-left mb-8 md:mb-10">
      <div class="text-xs font-bold text-primary tracking-wide mb-1.5">
        Why Upgrade Infotech
      </div>
      <h2 id="features-heading" class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-heading tracking-tight leading-tight">
        Why 2,840+ Students Chose Us to Launch Their SAP Careers
      </h2>
      <p class="mt-2 text-sm sm:text-base text-body font-normal leading-relaxed">
        Not just certification: a full runway from classroom to placement, built by people who still work in SAP.
      </p>
    </div>

    <!-- 6 Feature Cards (Title Beside Icon + Description Below) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4.5 sm:gap-5">
      {features.map((item) => (
        <div class="p-4.5 sm:p-5 rounded-xl bg-white border border-slate-200/90 shadow-sm flex flex-col justify-between transform transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-primary/40">
          <div>
            <!-- Header Row: Icon (No BG) Beside Title -->
            <div class="flex items-center gap-2.5 mb-2.5">
              <Fragment set:html={item.iconSvg} />
              <h3 class="text-base font-extrabold text-heading tracking-tight leading-snug">
                {item.title}
              </h3>
            </div>
            
            <!-- Description Below -->
            <p class="text-xs sm:text-sm text-body font-normal leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
