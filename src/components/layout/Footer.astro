---
// Masterclass Premium Light Footer (Compact & Highly Organized)
const quickLinks = [
  { name: "SAP FICO", href: "#pricing" },
  { name: "SAP MM", href: "#pricing" },
  { name: "SAP SD", href: "#pricing" },
  { name: "SAP HR", href: "#pricing" },
  { name: "Why Us", href: "#features" },
  { name: "Placements", href: "#testimonials" },
];
---

<footer class="bg-slate-50 text-slate-600 py-12 md:py-16 border-t border-slate-200 relative" aria-label="Site Footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-x-8 gap-y-10 mb-12">
      
      <!-- Column 1: Brand Overview (4/12) -->
      <div class="lg:col-span-4 flex flex-col space-y-5">
        <a href="#" class="inline-flex focus:outline-none" aria-label="Upgrade Infotech Home">
          <img
            src="/main_logo.png"
            alt="Upgrade Infotech Logo"
            class="h-10 sm:h-12 w-auto object-contain"
          />
        </a>
        <p class="text-[13px] text-slate-700 leading-relaxed font-medium max-w-sm">
          Mumbai's leading SAP Authorised Training Partner. We transform graduates and working professionals into highly-paid SAP consultants through practical, job-oriented training.
        </p>
        
        <!-- Social/WhatsApp -->
        <div class="flex items-center gap-3 pt-1">
          <!-- WhatsApp -->
          <a href="https://wa.me/917021348186" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-white border border-slate-200 hover:bg-[#1BD760] text-[#1BD760] hover:text-white transition-all shadow-sm" aria-label="WhatsApp">
