          </a>
          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/company/upgrade-language-academy" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-white border border-slate-200 hover:bg-[#0A66C2] text-[#0A66C2] hover:text-white transition-all shadow-sm" aria-label="LinkedIn">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links (2/12) -->
      <div class="lg:col-span-2">
        <h3 class="text-sm font-bold text-slate-900 mb-4">Quick Links</h3>
        <ul class="space-y-2.5 text-[13px] font-semibold text-slate-700">
          {quickLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-primary transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Head Office (3/12) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-sm font-bold text-slate-900 mb-4">Head Office</h3>
        
        <div class="text-[13px] text-slate-700 font-medium leading-relaxed flex items-start gap-2.5">
          <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>
            <strong class="text-slate-900 font-bold block mb-0.5">Ghatkopar (W)</strong>
            204, Rajgor Empire Building, Khot Lane, Junction, J.V. Rd, Mumbai, MH 400086.
          </span>
        </div>

        <div class="text-[13px] text-slate-700 font-bold flex items-center gap-2.5">
          <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <a href="tel:+917021348186" class="hover:text-primary transition-colors">+91 7021348186</a>
        </div>

        <div class="text-[13px] text-slate-700 font-bold flex items-center gap-2.5 break-all">
          <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <a href="mailto:contactatupgradeinfotech@gmail.com" class="hover:text-primary transition-colors">contactatupgradeinfotech@gmail.com</a>
        </div>
      </div>

      <!-- Column 4: Branches (3/12) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-sm font-bold text-slate-900 mb-4">Branches</h3>
        
        <!-- Branch 1: Andheri -->
        <div class="text-[13px] text-slate-700 font-medium leading-relaxed flex items-start gap-2.5">
          <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <span>
            <strong class="text-slate-900 font-bold block mb-0.5">Andheri (W)</strong>
            205, 2nd Floor, Times Chamber near paneeri showroom, S.V Road, Mumbai, MH 400058.
          </span>
        </div>

        <!-- Branch 2: Vashi -->
        <div class="text-[13px] text-slate-700 font-medium leading-relaxed flex items-start gap-2.5 mt-3">
          <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <span>
            <strong class="text-slate-900 font-bold block mb-0.5">Vashi, Navi Mumbai</strong>
            International Infotech Park, E-210, 2nd Floor, 3rd Tower, Navi Mumbai 400703.
          </span>
        </div>
        
      </div>

    </div>

    <!-- Bottom Copyright Row -->
    <div class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium text-slate-400 text-center sm:text-left">
      <p>Copyright © {new Date().getFullYear()} Eduwise Upgrade Infotech Pvt Ltd</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-primary transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-primary transition-colors">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
