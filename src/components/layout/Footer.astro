---
// Masterclass Zero-JS Accessible Footer Component (100% Exact Preserved User Copy & Layout)
const courseLinks = [
  { name: "SAP FICO", href: "#pricing" },
  { name: "SAP MM", href: "#pricing" },
  { name: "SAP SD", href: "#pricing" },
  { name: "SAP HR / SuccessFactors", href: "#pricing" },
  { name: "SAP ABAP", href: "#pricing" }
];

const instituteLinks = [
  { name: "Why Us", href: "#features" },
  { name: "Placements", href: "#testimonials" },
  { name: "Fees & EMI", href: "#pricing" },
  { name: "FAQ", href: "#faq" }
];
---

<footer class="bg-[#0B1B36] text-slate-300 pt-8 pb-20 sm:pt-12 sm:pb-24 lg:pt-16 lg:pb-16 border-t border-slate-800 relative overflow-hidden" aria-label="Site Footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Compact 2-Column Mobile / 4-Column Desktop Footer Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-12 gap-x-6 gap-y-8 sm:gap-8 mb-8 sm:mb-12">
      
      <!-- Column 1: Brand Overview (Full width on mobile, 4 Cols on desktop) -->
      <div class="col-span-2 lg:col-span-4 space-y-3">
        <a href="#" class="inline-flex items-center gap-2.5 group focus:outline-none" aria-label="Upgrade Infotech Home">
          <div class="w-8 h-8 sm:w-9 sm:h-9 bg-primary rounded-xl flex items-center justify-center text-white font-black text-xs sm:text-sm shadow-md">
            UI
          </div>
          <span class="font-extrabold text-xl sm:text-2xl tracking-tight text-white font-serif">Upgrade Infotech</span>
        </a>
        
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm font-medium">
          SAP Authorised Training Partner training Mumbai's finance, logistics & IT professionals since 2014.
        </p>

        <!-- Locations Tag -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/5 border border-white/10 text-[11px] sm:text-xs font-bold text-slate-300">
          <span>📍 Andheri · Ghatkopar · Vashi · Online</span>
        </div>
      </div>

      <!-- Column 2: Courses (Col 1 on mobile, 3 Cols on desktop) -->
      <div class="col-span-1 lg:col-span-3">
        <h3 class="text-xs font-black text-white uppercase tracking-widest mb-3">Courses</h3>
        <ul class="space-y-2 text-xs sm:text-sm font-medium text-slate-400">
          {courseLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-primary transition-colors flex items-center gap-1">
                <span class="text-primary/70">›</span>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Institute (Col 1 on mobile, 2 Cols on desktop - Side-by-side with Courses) -->
      <div class="col-span-1 lg:col-span-2">
        <h3 class="text-xs font-black text-white uppercase tracking-widest mb-3">Institute</h3>
        <ul class="space-y-2 text-xs sm:text-sm font-medium text-slate-400">
          {instituteLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-primary transition-colors flex items-center gap-1">
                <span class="text-primary/70">›</span>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact (Full width on mobile, 3 Cols on desktop - Compact horizontal list on mobile) -->
      <div class="col-span-2 lg:col-span-3 space-y-2.5">
        <h3 class="text-xs font-black text-white uppercase tracking-widest mb-2 sm:mb-4">Contact</h3>
        
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm font-medium">
          <a href="tel:+917021348186" class="flex items-center gap-2 text-slate-300 hover:text-white transition-colors">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>+91 70213 48186</span>
          </a>

          <a href="https://wa.me/917021348186" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-emerald-400 hover:text-emerald-300 transition-colors">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>WhatsApp Us</span>
          </a>

          <a href="mailto:info@upgradeinfotech.com" class="flex items-center gap-2 text-slate-300 hover:text-white transition-colors">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>info@upgradeinfotech.com</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Disclaimer Row -->
    <div class="pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] sm:text-xs text-slate-500 text-center sm:text-left">
      <p>© 2026 Upgrade Infotech. All rights reserved.</p>
      <p class="italic">
        Figures shown are sample placeholders — replace with verified data before launch.
      </p>
    </div>

  </div>
</footer>
