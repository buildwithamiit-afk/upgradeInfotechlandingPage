---
// Zero-JS Header Component with Refined Premium UI/UX Sizing
---

<header class="sticky top-0 z-40 w-full shadow-sm transition-all duration-200">
  <!-- Top Announcement Bar (Replaces Contact Info) -->
  <div class="w-full bg-primary-light border-b border-primary/20 py-1.5 sm:py-2 relative z-50 overflow-hidden flex items-center">
    <!-- Desktop View -->
    <div class="hidden sm:flex w-full max-w-7xl mx-auto px-4 justify-center items-center relative">
      <div class="text-sm text-primary font-medium flex items-center gap-2">
        <span class="text-base">📌</span>
        <span>Step into High-Growth Enterprise Roles, Join Our <strong class="font-black">SAP Mentorship Program</strong> <span class="text-primary/40 mx-1">|</span> <strong class="text-accent">Limited Seats</strong></span>
      </div>
      <a href="#enroll" class="absolute right-4 px-2 py-1 text-primary hover:text-primary-hover font-black text-[13px] sm:text-sm transition-colors whitespace-nowrap flex items-center gap-1 group">
        Enroll Now <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    <!-- Mobile View -->
    <div class="sm:hidden flex w-full items-center justify-between px-2 h-9">
      <div class="flex-grow overflow-hidden relative h-full flex items-center mr-2">
        <div class="mobile-marquee flex items-center w-max">
          <!-- First Item -->
          <div class="flex items-center gap-1.5 whitespace-nowrap pr-8 text-[13px] text-primary font-medium">
            <span class="text-base">📌</span>
            Step into High-Growth Enterprise Roles, Join Our <strong class="font-black">SAP Mentorship Program</strong> <strong class="text-accent ml-1">Limited Seats</strong>
          </div>
          <!-- Second Item (Duplicate for seamless loop) -->
          <div class="flex items-center gap-1.5 whitespace-nowrap pr-8 text-[13px] text-primary font-medium" aria-hidden="true">
            <span class="text-base">📌</span>
            Step into High-Growth Enterprise Roles, Join Our <strong class="font-black">SAP Mentorship Program</strong> <strong class="text-accent ml-1">Limited Seats</strong>
          </div>
        </div>
      </div>
      <a href="#enroll" class="shrink-0 relative z-10 px-2 py-1 text-primary active:text-primary-hover font-black text-[13px] transition-colors whitespace-nowrap flex items-center gap-1">
        Enroll Now <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <!-- Main Navigation Header (Balanced, Refined & Elegant UI/UX Bar) -->
  <div class="bg-bg border-b border-border">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
      
      <!-- Brand Logo (Actual Logo Image from public folder) -->
      <a href="#" class="flex items-center group focus:outline-none rounded-lg" aria-label="Upgrade Infotech Home">
        <img
          src="/main_logo.png"
          alt="Upgrade Infotech Logo"
          class="h-10 sm:h-12 w-auto object-contain transition-transform group-hover:scale-105"
        />
      </a>

      <!-- Desktop Navigation Links (Perfectly Centered) -->
      <nav class="hidden lg:flex items-center space-x-8 absolute left-1/2 -translate-x-1/2" aria-label="Primary Navigation">
        <a href="#curriculum" class="text-base font-bold text-slate-700 hover:text-primary transition-colors py-2 tracking-tight">Courses</a>
        <a href="#placement" class="text-base font-bold text-slate-700 hover:text-primary transition-colors py-2 tracking-tight">Placements</a>
        <a href="#compare" class="text-base font-bold text-slate-700 hover:text-primary transition-colors py-2 tracking-tight">Why Us</a>
        <a href="#faq" class="text-base font-bold text-slate-700 hover:text-primary transition-colors py-2 tracking-tight">FAQ</a>
      </nav>

      <!-- Desktop Action Items (Talk To Expert CTA) -->
      <div class="hidden lg:flex items-center">
        <a
          href="tel:+917021348186"
          class="animate-shimmer-btn overflow-hidden inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-bold text-white bg-accent hover:bg-accent-hover rounded-lg transition-colors focus:outline-none relative"
          aria-label="Talk To Expert"
        >
          <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="tracking-tight text-white font-bold">Talk To Expert</span>
        </a>
      </div>

      <!-- Mobile Action Items (Visible only on Mobile/Tablet) -->
      <div class="flex lg:hidden items-center gap-2 sm:gap-3">
        <!-- Mobile "Courses" Button -->
        <a href="#curriculum" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-800 text-xs font-bold shadow-sm active:bg-slate-50 transition-colors">
          Courses
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>

        <!-- Mobile "Talk To Expert" Icon Button -->
        <a href="tel:+917021348186" class="animate-shimmer-btn overflow-hidden flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 bg-white text-accent shadow-sm active:bg-slate-50 transition-colors relative" aria-label="Talk To Expert">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </a>

        <!-- Mobile CSS-Only Drawer Toggle -->
        <label for="mobile-menu-toggle" class="p-1.5 rounded-lg text-slate-800 active:bg-slate-100 cursor-pointer flex items-center justify-center transition-colors" aria-label="Toggle navigation menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
      </div>

    </div>

    <!-- Mobile Dropdown Menu (CSS Driven, Zero JS) -->
    <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
    <div class="hidden peer-checked:block lg:hidden bg-bg border-b border-border px-4 pt-3 pb-6 space-y-4 shadow-lg">
      <a href="#curriculum" class="mobile-nav-link block text-base font-semibold text-heading hover:text-primary py-2 border-b border-border/50">Courses</a>
      <a href="#placement" class="mobile-nav-link block text-base font-semibold text-heading hover:text-primary py-2 border-b border-border/50">Placements</a>
      <a href="#compare" class="mobile-nav-link block text-base font-semibold text-heading hover:text-primary py-2 border-b border-border/50">Why Us</a>
      <a href="#faq" class="mobile-nav-link block text-base font-semibold text-heading hover:text-primary py-2 border-b border-border/50">FAQ</a>
      
      <div class="pt-2 space-y-3">
        <!-- Direct Phone Link in Menu -->
        <a href="tel:+917021348186" class="flex items-center justify-center gap-2 text-heading font-bold text-sm py-2.5 rounded-xl bg-primary-light border border-primary/20">
          <svg class="w-4 h-4 text-heading shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call Us: +91 70213 48186</span>
        </a>

        <!-- Grid of Action CTAs in Mobile Menu: WhatsApp + Claim Offer -->
        <div class="grid grid-cols-2 gap-2.5 pt-1">
          <!-- WhatsApp Button in Drawer -->
          <a
            href="https://wa.me/917021348186?text=Hi%20Upgrade%20Infotech,%20I%20want%20to%20know%20more%20about%20the%20SAP%20courses"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 px-3 py-3 rounded-xl bg-[#25D366] text-white font-extrabold text-xs shadow-sm hover:bg-[#20ba59] active:bg-[#25D366]"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>WhatsApp Us</span>
          </a>

          <!-- Claim Limited Offer Button in Drawer -->
          <a
            href="#enroll"
            class="mobile-nav-link flex items-center justify-center text-center px-3 py-3 rounded-xl bg-accent text-white font-extrabold text-xs shadow-sm hover:bg-accent-hover active:bg-accent"
          >
            <span>Claim Offer</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</header>

<!-- FIXED BOTTOM MOBILE ACTION BAR (Sticky Navigation Bar for Mobile View) -->
<nav
  class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 p-2 sm:p-3 shadow-[0_-4px_25px_rgba(0,0,0,0.12)] transition-all"
  aria-label="Mobile Quick Action Navigation"
>
  <div class="max-w-md mx-auto grid grid-cols-2 gap-2 sm:gap-3">
    
    <!-- 1. WHATSAPP BUTTON -->
    <a
      href="https://wa.me/917021348186?text=Hi%20Upgrade%20Infotech,%20I%20want%20to%20know%20more%20about%20the%20SAP%20courses"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center min-h-[46px] px-3 py-2.5 rounded-xl bg-gradient-to-r from-[#25D366] to-[#128C7E] text-white font-extrabold text-xs sm:text-sm tracking-tight shadow-md shadow-emerald-500/20 active:scale-[0.98] transition-transform gap-1.5"
      aria-label="Chat with Upgrade Infotech on WhatsApp"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>Chat on WhatsApp</span>
    </a>

    <!-- 2. CLAIM LIMITED OFFER BUTTON -->
    <a
      href="#enroll"
      class="inline-flex items-center justify-center min-h-[46px] px-3 py-2.5 rounded-xl bg-gradient-to-r from-accent via-primary to-accent text-white font-black text-xs sm:text-sm tracking-tight shadow-md shadow-accent/30 active:scale-[0.98] transition-transform gap-1.5 relative overflow-hidden"
      aria-label="Claim Limited Offer"
    >
      <span class="w-2 h-2 rounded-full bg-white animate-ping shrink-0" aria-hidden="true"></span>
      <span class="truncate">Claim Limited Offer</span>
    </a>

  </div>
</nav>

<script>
  // Close mobile menu when a navigation link is clicked
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle') as HTMLInputElement;
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

    if (mobileMenuToggle) {
      mobileNavLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenuToggle.checked = false;
        });
      });
    }
  });
</script>

<style>
  .mobile-marquee {
    animation: scroll-left-seamless 25s linear infinite;
  }
  @keyframes scroll-left-seamless {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
