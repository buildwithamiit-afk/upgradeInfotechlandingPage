---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You | Upgrade Infotech">
  <main class="min-h-screen bg-slate-50 flex items-center justify-center p-4 sm:p-8">
    <div class="max-w-6xl w-full bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col md:flex-row">
      
      <!-- Left side (Image) -->
      <div class="w-full md:w-1/2 bg-white flex items-center justify-center p-6 md:p-10 border-b md:border-b-0 md:border-r border-slate-100">
        <img src="/thank_you_page_img.webp" alt="Join the Ranks of Globally Certified SAP Professionals" class="w-full max-w-lg h-auto object-contain" />
      </div>

      <!-- Right side (Content) -->
      <div class="w-full md:w-1/2 p-8 md:p-12 lg:p-16 flex flex-col justify-center">
        <!-- Green Checkmark -->
        <div class="w-14 h-14 bg-[#198754] rounded-full flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>

        <h1 class="text-4xl md:text-5xl font-black text-slate-900 mb-5" style="font-family: 'Playfair Display', serif;">
          Thank You!
        </h1>
        
        <p class="text-slate-600 text-lg mb-8 leading-relaxed">
          Your submission has been received. While you wait for our team to contact you, please check our latest brochure.
        </p>

        <div class="flex flex-col space-y-4 max-w-md">
          <a
            href="/brochure.pdf"
            download="Upgrade_Infotech_Brochure.pdf"
            class="w-full flex items-center justify-center py-3.5 px-6 bg-[#0d6efd] hover:bg-blue-700 text-white font-semibold rounded-lg shadow-sm transition-colors text-[17px]"
          >
            Download Brochure
          </a>
          
          <a
            href="/"
            class="w-full flex items-center justify-center py-3.5 px-6 bg-white hover:bg-slate-50 text-slate-700 font-semibold border border-slate-300 rounded-lg shadow-sm transition-colors text-[17px]"
          >
            Back to Home
          </a>
        </div>
      </div>
      
    </div>
  </main>
</Layout>
