---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

import HeroSection from '../components/sections/HeroSection.astro';
import FeaturesSection from '../components/sections/FeaturesSection.astro';
import CurriculumSection from '../components/sections/CurriculumSection.astro';
import JourneySection from '../components/sections/JourneySection.astro';
import PlacementSection from '../components/sections/PlacementSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaSection from '../components/sections/CtaSection.astro';

import MidPageCta from '../components/common/MidPageCta.astro';
import ExitIntentPopup from '../components/common/ExitIntentPopup.astro';
import PlacementReportPopup from '../components/common/PlacementReportPopup.astro';
import WhatsAppButton from '../components/common/WhatsAppButton.astro';
---

<Layout
  title="Best SAP Training Institute in Andheri, Mumbai | Upgrade Infotech — 100% Placement"
  description="Master SAP FICO, MM, SD, HR & ABAP with certified SAP consultants in Andheri, Ghatkopar, Vashi & Live Online. 100% Placement Assistance & No-Cost EMI at Upgrade Infotech."
>
  <Header />
  
  <main id="main-content" class="flex-grow">
    <!-- 1. Hero Section -->
    <HeroSection />

    <!-- 2. Why Upgrade Infotech (Trust/Credibility + Practising Consultants) -->
    <FeaturesSection />

    <!-- 3. Pick Your SAP Module (Curriculum Section) -->
    <CurriculumSection />

    <!-- 4. From Classroom to Career (3-Step Process) -->
    <JourneySection />

    <!-- 5. Placements & 500+ Recruiter Partners -->
    <PlacementSection />

    <!-- Mid-Page Conversion CTA Banner 1 -->
    <MidPageCta />

    <!-- 6. Testimonials (Student Success Stories) -->
    <TestimonialsSection />

    <!-- Mid-Page Conversion CTA Banner 2 -->
    <MidPageCta />

    <!-- 7. Upgrade Infotech vs. Other Mumbai Institutes (Comparison Table) -->
    <BenefitsSection />

    <!-- 8. FAQ (Objection Handling) -->
    <FaqSection />

    <!-- 9. Final CTA (Monsoon Offer Urgency Banner) -->
    <CtaSection />
  </main>

  <Footer />

  <!-- Client-side Popups & Floating Buttons -->
  <ExitIntentPopup />
  <PlacementReportPopup />
  <WhatsAppButton />
</Layout>

<style is:global>
  @keyframes btn-shimmer {
    0% { transform: translateX(-150%) skewX(-15deg); }
    100% { transform: translateX(250%) skewX(-15deg); }
  }
  .animate-shimmer-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.15) 20%, rgba(255, 255, 255, 0.6) 50%, rgba(255, 255, 255, 0.15) 80%, transparent);
    animation: btn-shimmer 3s ease-in-out infinite;
  }
</style>
